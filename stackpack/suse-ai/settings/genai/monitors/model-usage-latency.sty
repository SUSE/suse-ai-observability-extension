nodes:
- _type: Monitor
  name: 'Model called by service: calls are slow'
  identifier: urn:stackpack:suse-ai:monitor:model-usage-latency
  description: Model client health for a specific caller, provider and endpoint; aggregates caller replicas.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:topological-threshold
  arguments:
    threshold: 30.0
    comparator: GT
    failureState: DEVIATING
    queries:
      topologyQuery: type = "genai model usage" and label = "stackpack:suse-ai"
      promqlQuery: histogram_quantile(0.95, sum by (service_namespace, service_name, gen_ai_request_model, le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_namespace="${tags.service.namespace}",
        service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}",
        server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[5m])))
      aliasTemplate: Model request latency
      unit: s
    titleTemplate: 'Model ${gen_ai_request_model} called by ${service_name}: calls are slow'
  remediationHint: !include 'remediation-hints/genai/model-usage-latency.md.hbs'
