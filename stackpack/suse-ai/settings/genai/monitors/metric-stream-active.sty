nodes:
- _type: Monitor
  name: "AI telemetry freshness"
  identifier: urn:stackpack:suse-ai:monitor:genai-metric-stream-active
  description: "Identifies gaps in AI monitoring when a previously observed metric stream stops reporting for five minutes. An idle application remains healthy while it sends samples. The check stops emitting a result after the 15-minute observation window expires."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 300.0
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: "Age of last AI metric sample"
      query: time() - (max by (service_namespace, service_name) (max_over_time(timestamp(gen_ai_client_operation_duration_seconds_count{service_namespace!="",
        service_name!="", suse_ai_managed!="false"})[15m:15s])) > time() - 900)
      unit: s
    titleTemplate: "AI telemetry freshness: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/genai/genai-metric-stream-active.md.hbs'
