nodes:
- _type: Monitor
  name: "AI telemetry freshness"
  identifier: urn:stackpack:suse-ai:monitor:genai-metric-stream-active
  description: "Checks periodically exported GenAI client duration counts after their first sample. The caller deviates when any observed target has been silent for over five minutes. Its duration evidence expires at fifteen minutes."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 300.0
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: "Oldest target duration sample age (s)"
      # A stale marker can hide a sample from timestamp() between 15s steps.
      # A nonempty raw bucket then bounds its timestamp from below. The raw
      # 15m selector owns expiry, independent of lookback and bucket rounding.
      # The 5m1ms floor keeps age <= 300 at the inclusive millisecond boundary.
      # The age candidates are nameless. Match on metric name so 'or' also
      # retains the lower bound for the target max, regardless of input labels.
      query: >-
        clamp_max(time() - min by (service_namespace, service_name) (
          max by (service_namespace, service_name, k8s_cluster_name, service_instance_id,
                  otel_scope_name, gen_ai_provider_name, gen_ai_request_model, server_address, server_port) (
            (
              (
                timestamp(gen_ai_client_operation_duration_seconds_count{
                  service_namespace!="", service_name!="", suse_ai_managed!="false"
                })
                or
                (time() - 15) * present_over_time(gen_ai_client_operation_duration_seconds_count{
                  service_namespace!="", service_name!="", suse_ai_managed!="false"
                }[15s])
                or
                max_over_time((
                  timestamp(gen_ai_client_operation_duration_seconds_count{
                    service_namespace!="", service_name!="", suse_ai_managed!="false"
                  })
                  or
                  (time() - 15) * present_over_time(gen_ai_client_operation_duration_seconds_count{
                    service_namespace!="", service_name!="", suse_ai_managed!="false"
                  }[15s])
                )[15m:15s])
              )
              and present_over_time(gen_ai_client_operation_duration_seconds_count{
                service_namespace!="", service_name!="", suse_ai_managed!="false"
              }[15m])
            )
            or on (__name__)
            label_replace((time() - 300) * present_over_time(gen_ai_client_operation_duration_seconds_count{
              service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[5m1ms]), "__name__", "fresh_duration_bound", "", "")
          )
        ), 900)
      unit: s
    titleTemplate: "AI telemetry freshness: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/genai/genai-metric-stream-active.md.hbs'
