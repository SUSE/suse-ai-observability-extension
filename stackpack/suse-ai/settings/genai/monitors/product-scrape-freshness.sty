nodes:
- _type: Monitor
  name: "Product metrics scrape freshness"
  identifier: urn:stackpack:suse-ai:monitor:product-scrape-freshness
  description: "Counts previously observed Prometheus scrape targets that have stopped reporting scrape results for more than five minutes."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.0
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: "Silent scrape targets"
      unit: short
      # A fresh source wins the union with 0. A source seen only in the longer window yields 1.
      # Range selectors exclude the left endpoint; include the millisecond at exactly five minutes.
      query: >-
        sum by (service_namespace, service_name) (
          0 * group by (service_namespace, service_name, suse_ai_product,
                        k8s_cluster_name, service_instance_id, job, instance) (
            present_over_time(up{
              suse_ai_product=~"kserve|kubeflow-pipelines|litellm|milvus|qdrant|vllm", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[5m1ms])
          )
          or
          group by (service_namespace, service_name, suse_ai_product,
                    k8s_cluster_name, service_instance_id, job, instance) (
            present_over_time(up{
              suse_ai_product=~"kserve|kubeflow-pipelines|litellm|milvus|qdrant|vllm", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[15m])
          )
        )
    titleTemplate: "Metrics scrape freshness: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/genai/product-scrape-freshness.md.hbs'
