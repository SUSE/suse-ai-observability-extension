nodes:
- _type: Monitor
  name: 'Model called by service: requests are failing'
  identifier: urn:stackpack:suse-ai:monitor:model-usage-errors
  description: Model client health for a specific caller, provider and endpoint; aggregates caller replicas.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:topological-threshold
  arguments:
    threshold: 0.05
    comparator: GT
    failureState: DEVIATING
    queries:
      topologyQuery: type = "genai model usage" and label = "stackpack:suse-ai"
      promqlQuery: ((sum by (service_namespace, service_name, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{service_namespace="${tags.service.namespace}",
        service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}",
        server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}",
        error_type!=""}[5m])) or (sum by (service_namespace, service_name, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{service_namespace="${tags.service.namespace}",
        service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}",
        server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[5m]))
        * 0)) / sum by (service_namespace, service_name, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{service_namespace="${tags.service.namespace}",
        service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}",
        server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[5m])))
        and (sum by (service_namespace, service_name, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{service_namespace="${tags.service.namespace}",
        service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}",
        server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[5m]))
        > 0)
      aliasTemplate: Model request failures
      unit: percentunit
    titleTemplate: 'Model ${gen_ai_request_model} called by ${service_name}: requests are failing'
  remediationHint: !include 'remediation-hints/genai/model-usage-errors.md.hbs'
