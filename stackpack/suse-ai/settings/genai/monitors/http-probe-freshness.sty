nodes:
- _type: Monitor
  name: "AI endpoint probe freshness"
  identifier: urn:stackpack:suse-ai:monitor:http-probe-freshness
  description: "Counts configured HTTP probes whose previously observed status has stopped arriving for more than five minutes."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.0
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: "Silent HTTP probes"
      unit: short
      # A fresh source wins the union with 0. A source seen only in the longer window yields 1.
      # Range selectors exclude the left endpoint; include the millisecond at exactly five minutes.
      query: >-
        sum by (service_namespace, service_name) (
          0 * group by (service_namespace, service_name,
                        k8s_cluster_name, service_instance_id, http_url, http_method) (
            present_over_time(httpcheck_status{
              suse_ai_observation_kind="http-probe", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[5m1ms])
            or
            present_over_time(httpcheck_status{
              suse_ai_product="kubeflow-model-registry", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[5m1ms])
          )
          or
          group by (service_namespace, service_name,
                    k8s_cluster_name, service_instance_id, http_url, http_method) (
            present_over_time(httpcheck_status{
              suse_ai_observation_kind="http-probe", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[15m])
            or
            present_over_time(httpcheck_status{
              suse_ai_product="kubeflow-model-registry", service_namespace!="", service_name!="", suse_ai_managed!="false"
            }[15m])
          )
        )
    titleTemplate: "Endpoint probe freshness: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/genai/http-probe-freshness.md.hbs'
