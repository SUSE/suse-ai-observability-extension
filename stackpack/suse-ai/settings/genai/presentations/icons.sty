# Preserve native service/instance icons unless a supported product is identified.
nodes:
- _type: ComponentPresentation
  name: elasticsearch icon
  identifier: urn:stackpack:suse-ai:component-presentation:icon-product-elasticsearch
  binding:
    _type: ComponentPresentationQueryBinding
    query: 'label = "stackpack:suse-ai" and type in ("otel service", "otel service instance") and label = "suse.ai.product:elasticsearch"'
  rank:
    specificity: 120
  presentation:
    icon: !icon products/elasticsearch.svg
