nodes:
- _type: ComponentPresentation
  name: Model deployment
  identifier: urn:stackpack:suse-ai:component-presentation:served-models
  binding:
    _type: ComponentPresentationQueryBinding
    query: (type = "genai served model" and label = "stackpack:suse-ai")
  rank:
    specificity: 220
  presentation:
    icon: !icon outline/model.svg
    overview:
      name:
        singular: model deployment
        plural: model deployment
        title: Model deployment
      columns:
      - columnId: suse_ai_otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_service
        title: Inference service
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: '''urn:opentelemetry:namespace/'' + tags.singleValue(''service.namespace'') + '':service/''
            + tags.singleValue(''service.name'')'
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: tags.singleValue('suse.ai.product')
      - columnId: suse_ai_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: '''cluster-name'' in tags ? tags[''cluster-name''].filter(cluster, cluster != '''').join('', '')
            : '''''
      sort:
      - columnId: suse_ai_otel_name
    highlight:
      title: Model deployment
      fields:
      - fieldId: suse_ai_served_model_health
        title: Health
        order: 100
        projection:
          _type: HealthProjection
          value: healthState
      relatedResources:
      - resourceId: suse_ai_service
        title: Related services
        order: 90
        topologyQuery: withNeighborsOf(direction = "both", components = (identifier = "${identifiers[0]}"), levels
          = "1") and type = "otel service"
        presentationIdentifier: urn:stackpack:suse-ai:component-presentation:services
      links:
      - linkId: suse_ai_model_inventory
        title: All models
        target: /#/views/urn:stackpack:suse-ai:component-presentation:model-inventory
        order: 50
