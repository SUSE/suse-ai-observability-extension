nodes:
- _type: ComponentPresentation
  name: Model deployment
  identifier: urn:stackpack:suse-ai:component-presentation:served-models
  binding:
    _type: ComponentPresentationQueryBinding
    query: (type = "genai served model" and label = "stackpack:suse-ai")
  rank:
    specificity: 220
  presentation:
    icon: !icon model.svg
    overview:
      name:
        singular: model deployment
        plural: model deployment
        title: Model deployment
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_service
        title: Inference service
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: "'urn:opentelemetry:namespace/' + tags.singleValue('service.namespace') + ':service/' + tags.singleValue('service.name')"
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: tags.singleValue('suse.ai.product')
      - columnId: suse_ai_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: "tags.singleValue('cluster-name') != '' ? tags.singleValue('cluster-name') : 'not reported'"
      - columnId: suse_ai_request_metrics
        title: Server request metrics
        projection:
          _type: TextProjection
          value: "tags.singleValue('suse.ai.product') == 'vllm' ? 'See model charts' : 'not reported'"
      - columnId: suse_ai_residency_metrics
        title: Model residency metrics
        projection:
          _type: TextProjection
          value: "tags.singleValue('suse.ai.product') == 'ollama' ? 'See model charts' : 'not reported'"
      sort:
      - columnId: health
      - columnId: otel_name
    highlight:
      title: Model deployment
      relatedResources:
      - resourceId: suse_ai_service
        title: Related services
        order: 90
        topologyQuery: >-
          withNeighborsOf(direction = "both", components = (identifier = "${identifiers[0]}"), levels = "1") and type
          = "otel service"
        presentationIdentifier: urn:stackpack:suse-ai:component-presentation:services
      links:
      - linkId: suse_ai_model_inventory
        title: All models
        target: /#/views/urn:stackpack:suse-ai:component-presentation:model-inventory
        order: 50
