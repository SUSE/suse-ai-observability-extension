nodes:
- _type: ComponentPresentation
  name: Search engines
  identifier: urn:stackpack:suse-ai:component-presentation:role-search-engine
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type = "otel service" and label = "stackpack:suse-ai" and label
      = "suse.ai.category:search-engine")
  rank:
    specificity: 230
  presentation:
    icon: !icon search-engine.png
    filters:
    - filterId: otel_namespace
    - filterId: k8s_cluster
    - filterId: k8s_namespace
    - filterId: suse_ai_suse_ai_category
    - filterId: suse_ai_suse_ai_product
    overview:
      name:
        singular: Search engine
        plural: search engines
        title: Search engines
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_category
      - columnId: suse_ai_product
      - columnId: otel_k8s_cluster
      - columnId: otel_k8s_namespace
      sort:
      - columnId: health
      - columnId: otel_name
