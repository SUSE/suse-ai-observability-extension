nodes:
- _type: ComponentPresentation
  name: Applications
  identifier: urn:stackpack:suse-ai:component-presentation:role-application
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:open-telemetry" and label = "stackpack:suse-ai" and type = "otel service" and (label
      IN ("suse.ai.category:application") or not label IN ("suse.ai.category:application", "suse.ai.category:agent",
      "suse.ai.category:ui", "suse.ai.category:inference-engine", "suse.ai.category:model-proxy", "suse.ai.category:vectordb",
      "suse.ai.category:search-engine", "suse.ai.category:mcp-server", "suse.ai.category:workflow-engine", "suse.ai.category:ml-registry"))
  rank:
    specificity: 1
  presentation:
    filters:
    - filterId: suse_ai_otel_namespace
      displayName:
        singular: Service namespace
        plural: Service namespaces
      filter:
        _type: TagFilter
        tagKey: service.namespace
      menuSection: SUSE AI
    - filterId: suse_ai_k8s_cluster
      displayName:
        singular: K8s cluster
        plural: K8s clusters
      filter:
        _type: TagFilter
        tagKey: cluster-name
      menuSection: K8s
    - filterId: suse_ai_k8s_namespace
      displayName:
        singular: Kubernetes namespace
        plural: Kubernetes namespaces
      filter:
        _type: TagFilter
        tagKey: k8s.namespace.name
      menuSection: SUSE AI
    - filterId: suse_ai_suse_ai_category
      displayName:
        singular: Category
        plural: Categories
      filter:
        _type: TagFilter
        tagKey: suse.ai.category
      menuSection: SUSE AI
    - filterId: suse_ai_suse_ai_product
      displayName:
        singular: Product
        plural: Products
      filter:
        _type: TagFilter
        tagKey: suse.ai.product
      menuSection: SUSE AI
    overview:
      name:
        singular: Application
        plural: applications
        title: Applications
      columns:
      - columnId: suse_ai_otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_category
        title: Category
        projection:
          _type: TextProjection
          value: '''suse.ai.category'' in tags && size(tags[''suse.ai.category'']) > 0 ? tags[''suse.ai.category''].map(category,
            category in {''application'': ''Application'', ''agent'': ''Agent service'', ''ui'': ''AI interface'',
            ''inference-engine'': ''Inference'', ''model-proxy'': ''Model gateway'', ''vectordb'': ''Vector database'',
            ''search-engine'': ''Search'', ''mcp-server'': ''MCP server'', ''workflow-engine'': ''Workflow'', ''ml-registry'':
            ''Model registry''} ? {''application'': ''Application'', ''agent'': ''Agent service'', ''ui'': ''AI
            interface'', ''inference-engine'': ''Inference'', ''model-proxy'': ''Model gateway'', ''vectordb'':
            ''Vector database'', ''search-engine'': ''Search'', ''mcp-server'': ''MCP server'', ''workflow-engine'':
            ''Workflow'', ''ml-registry'': ''Model registry''}[category] : category).join('', '') : (''vllm.model.name''
            in tags ? ''Model deployment'' : (''gen_ai.agent.name'' in tags ? ''Agent'' : (''gen_ai.request.model''
            in tags ? ''Model usage'' : ''Application'')))'
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: '''suse.ai.product'' in tags ? tags[''suse.ai.product''].join('', '') : '''''
      - columnId: suse_ai_otel_k8s_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: '''cluster-name'' in tags ? tags[''cluster-name''].filter(cluster, cluster != '''').join('', '')
            : '''''
      sort:
      - columnId: suse_ai_otel_name
