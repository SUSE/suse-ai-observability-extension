nodes:
- _type: ComponentPresentation
  name: Data services
  identifier: urn:stackpack:suse-ai:component-presentation:data-services
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:suse-ai" and type = "otel service" and label IN ("suse.ai.category:vectordb", "suse.ai.category:search-engine")
  rank:
    specificity: 1
  presentation:
    overview:
      name:
        singular: data service
        plural: data services
        title: Data services
      columns:
      - columnId: suse_ai_health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: suse_ai_otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: '''suse.ai.product'' in tags ? tags[''suse.ai.product''].join('', '') : '''''
      - columnId: suse_ai_otel_k8s_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: '''cluster-name'' in tags ? tags[''cluster-name''].filter(cluster, cluster != '''').join('', '')
            : '''''
      sort:
      - columnId: suse_ai_otel_name
      mainMenu:
        group: SUSE AI
        icon: !icon outline/data-services.svg
        order: 60
