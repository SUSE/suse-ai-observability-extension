nodes:
- _type: ComponentPresentation
  name: Data services
  identifier: urn:stackpack:suse-ai:component-presentation:data-services
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:suse-ai" and type IN ("otel service", "genai database dependency") and label IN ("suse.ai.category:vectordb",
      "suse.ai.category:search-engine")
  rank:
    specificity: 225
  presentation:
    overview:
      name:
        singular: data service
        plural: data services
        title: Data services
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_category
      - columnId: suse_ai_product
      - columnId: suse_ai_discovery
        title: Discovery
        projection:
          _type: TextProjection
          value: "'suse.ai.discovery' in tags ? 'Observed from client' : 'Service telemetry'"
      - columnId: otel_k8s_cluster
      - columnId: suse_ai_observer_service
      - columnId: suse_ai_observer_cluster
      - columnId: otel_k8s_namespace
      sort:
      - columnId: health
      - columnId: otel_name
      mainMenu:
        group: SUSE AI
        icon: !icon menu/vectordb.svg
        order: 60
