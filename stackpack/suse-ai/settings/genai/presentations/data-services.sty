nodes:
- _type: ComponentPresentation
  name: Data services
  identifier: urn:stackpack:suse-ai:component-presentation:data-services
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:suse-ai" and type = "otel service" and label IN ("suse.ai.category:vectordb",
      "suse.ai.category:search-engine")
  rank:
    specificity: 225
  presentation:
    overview:
      name:
        singular: data service
        plural: data services
        title: Data services
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_product
      - columnId: otel_k8s_cluster
      - columnId: suse_ai_data_metrics
        title: Key metrics
        projection:
          _type: ComponentLinkProjection
          name: >-
            tags.singleValue('suse.ai.product') == 'milvus' ? 'Search latency, request rate' :
            (tags.singleValue('suse.ai.product') == 'qdrant' ? 'Collections, response rate' :
            (tags.singleValue('suse.ai.product') == 'opensearch' ? 'Cluster health, pending tasks' : 'Service metrics'))
          identifier: identifiers[0]
      sort:
      - columnId: health
      - columnId: otel_name
      mainMenu:
        group: SUSE AI
        icon: !icon menu/vectordb.svg
        order: 60
