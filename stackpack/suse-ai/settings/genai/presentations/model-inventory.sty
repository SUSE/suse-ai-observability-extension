nodes:
- _type: ComponentPresentation
  name: Models
  identifier: urn:stackpack:suse-ai:component-presentation:model-inventory
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:suse-ai" and type = "genai served model"
  rank:
    specificity: 205
  presentation:
    overview:
      name:
        singular: model
        plural: models
        title: Models
      columns:
      - columnId: suse_ai_otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_service
        title: Inference service
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: '''urn:opentelemetry:namespace/'' + tags.singleValue(''service.namespace'') + '':service/''
            + tags.singleValue(''service.name'')'
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: tags.singleValue('suse.ai.product')
      - columnId: suse_ai_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: '''cluster-name'' in tags ? tags[''cluster-name''].filter(cluster, cluster != '''').join('', '')
            : '''''
      sort:
      - columnId: suse_ai_otel_name
      mainMenu:
        group: SUSE AI
        icon: !icon outline/model.svg
        order: 80
