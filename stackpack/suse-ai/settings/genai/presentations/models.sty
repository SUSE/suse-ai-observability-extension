nodes:
- _type: ComponentPresentation
  name: Model usage
  identifier: urn:stackpack:suse-ai:component-presentation:models
  binding:
    _type: ComponentPresentationQueryBinding
    query: (type = "genai model usage" and label = "stackpack:suse-ai")
  rank:
    specificity: 210
  presentation:
    icon: !icon model.svg
    overview:
      name:
        singular: model usage
        plural: model usage
        title: Model usage
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('gen_ai.request.model') + ' used by ' + tags.singleValue('service.name')
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_service
        title: Application
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: "'urn:opentelemetry:namespace/' + tags.singleValue('service.namespace') + ':service/' + tags.singleValue('service.name')"
      - columnId: suse_ai_usage_requests
        title: Requests / s
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: reqps
          query: sum by (service_namespace, service_name, gen_ai_request_model, gen_ai_provider_name, server_address, server_port)
            (rate(gen_ai_client_operation_duration_seconds_count{service_namespace="${tags.singleValue('service.namespace')}",
            service_name="${tags.singleValue('service.name')}", gen_ai_request_model="${tags.singleValue('gen_ai.request.model')}",
            gen_ai_provider_name="${tags.singleValue('gen_ai.provider.name')}", server_address="${tags.singleValue('server.address')}",
            server_port="${tags.singleValue('server.port')}"}[${__rate_interval}]))
          metricId: suse-ai-requests
      - columnId: suse_ai_usage_latency
        title: Duration P95
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: s
          query: histogram_quantile(0.95, sum by (service_namespace, service_name, gen_ai_request_model, gen_ai_provider_name,
            server_address, server_port, le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_namespace="${tags.singleValue('service.namespace')}",
            service_name="${tags.singleValue('service.name')}", gen_ai_request_model="${tags.singleValue('gen_ai.request.model')}",
            gen_ai_provider_name="${tags.singleValue('gen_ai.provider.name')}", server_address="${tags.singleValue('server.address')}",
            server_port="${tags.singleValue('server.port')}"}[${__rate_interval}])))
          metricId: suse-ai-latency
      - columnId: suse_ai_usage_tokens
        title: Tokens / s
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: short
          query: sum by (service_namespace, service_name, gen_ai_request_model, gen_ai_provider_name, server_address, server_port)
            (rate({__name__=~"gen_ai_client_token_usage(_tokens)?_sum", service_namespace="${tags.singleValue('service.namespace')}",
            service_name="${tags.singleValue('service.name')}", gen_ai_request_model="${tags.singleValue('gen_ai.request.model')}",
            gen_ai_provider_name="${tags.singleValue('gen_ai.provider.name')}", server_address="${tags.singleValue('server.address')}",
            server_port="${tags.singleValue('server.port')}"}[${__rate_interval}]))
          metricId: suse-ai-tokens
      sort:
      - columnId: health
    highlight:
      title: Model usage
      fields:
      - fieldId: suse_ai_application
        title: Application
        order: 100
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: "'urn:opentelemetry:namespace/' + tags.singleValue('service.namespace') + ':service/' + tags.singleValue('service.name')"
      - fieldId: suse_ai_gen_ai.request.model
        title: Model
        order: 90
        projection:
          _type: TextProjection
          value: tags.singleValue('gen_ai.request.model')
      - fieldId: suse_ai_gen_ai.provider.name
        title: Provider
        order: 85
        projection:
          _type: TextProjection
          value: tags.singleValue('gen_ai.provider.name')
      - fieldId: suse_ai_server.address
        title: Endpoint
        order: 80
        projection:
          _type: TextProjection
          value: tags.singleValue('server.address')
      - fieldId: suse_ai_server.port
        title: Port
        order: 75
        projection:
          _type: TextProjection
          value: tags.singleValue('server.port')
      relatedResources:
      - resourceId: suse_ai_service
        title: Related services
        order: 90
        topologyQuery: >-
          identifier = "urn:opentelemetry:namespace/${tags.singleValue('service.namespace')}:service/${tags.singleValue('service.name')}"
        presentationIdentifier: urn:stackpack:suse-ai:component-presentation:services
      links:
      - linkId: suse_ai_model_inventory
        title: All models
        target: /#/views/urn:stackpack:suse-ai:component-presentation:model-inventory
        order: 50
    tracesPerspective:
      showTraces: true
      spanFilter:
        serviceName:
        - ${tags.singleValue('service.name')}
        attributes:
          service.namespace:
          - ${tags.singleValue('service.namespace')}
          gen_ai.request.model:
          - ${tags.singleValue('gen_ai.request.model')}
          # Keep explicit empty matchers: omitting an unknown endpoint broadens
          # the trace link to every endpoint used by this service/model.
          server.address:
          - ${tags.singleValue('server.address')}
          server.port:
          - ${tags.singleValue('server.port')}
          __multi__:
          - ${selectPrefix(tags, 'suse.ai.trace.')}
