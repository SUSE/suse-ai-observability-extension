nodes:
- _type: ComponentPresentation
  name: Model usage
  identifier: urn:stackpack:suse-ai:component-presentation:models
  binding:
    _type: ComponentPresentationQueryBinding
    query: (type = "genai model usage" and label = "stackpack:suse-ai")
  rank:
    specificity: 210
  presentation:
    icon: !icon outline/model-usage.svg
    overview:
      name:
        singular: model usage
        plural: model usage
        title: Model usage
      columns:
      - columnId: suse_ai_health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: suse_ai_otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('gen_ai.request.model') + ' used by ' + tags.singleValue('service.name')
          identifier: identifiers[0]
      - columnId: suse_ai_otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_service
        title: Application
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: '''urn:opentelemetry:namespace/'' + tags.singleValue(''service.namespace'') + '':service/''
            + tags.singleValue(''service.name'')'
      sort: []
    highlight:
      title: Model usage
      fields:
      - fieldId: suse_ai_application
        title: Application
        order: 100
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('service.name')
          identifier: '''urn:opentelemetry:namespace/'' + tags.singleValue(''service.namespace'') + '':service/''
            + tags.singleValue(''service.name'')'
      - fieldId: suse_ai_gen_ai_request_model
        title: Model
        order: 90
        projection:
          _type: TextProjection
          value: tags.singleValue('gen_ai.request.model')
      - fieldId: suse_ai_gen_ai_provider_name
        title: Provider
        order: 85
        projection:
          _type: TextProjection
          value: tags.singleValue('gen_ai.provider.name')
      - fieldId: suse_ai_server_address
        title: Endpoint
        order: 80
        projection:
          _type: TextProjection
          value: tags.singleValue('server.address')
      - fieldId: suse_ai_server_port
        title: Port
        order: 75
        projection:
          _type: TextProjection
          value: tags.singleValue('server.port')
      relatedResources:
      - resourceId: suse_ai_service
        title: Related services
        order: 90
        topologyQuery: identifier = "urn:opentelemetry:namespace/${tags.singleValue('service.namespace')}:service/${tags.singleValue('service.name')}"
        presentationIdentifier: urn:stackpack:suse-ai:component-presentation:services
      links:
      - linkId: suse_ai_model_inventory
        title: All models
        target: /#/views/urn:stackpack:suse-ai:component-presentation:model-inventory
        order: 50
    tracesPerspective:
      showTraces: true
      spanFilter:
        serviceName:
        - ${tags.singleValue('service.name')}
        attributes:
          service.namespace:
          - ${tags.singleValue('service.namespace')}
          gen_ai.request.model:
          - ${tags.singleValue('gen_ai.request.model')}
          server.address:
          - ${tags.singleValue('server.address')}
          server.port:
          - ${tags.singleValue('server.port')}
          __multi__:
          - ${selectPrefix(tags, 'suse.ai.trace.')}
