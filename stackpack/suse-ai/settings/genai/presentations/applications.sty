nodes:
- _type: ComponentPresentation
  name: Applications and agents
  identifier: urn:stackpack:suse-ai:component-presentation:applications
  binding:
    _type: ComponentPresentationQueryBinding
    query: >-
      label = "stackpack:suse-ai" and type = "otel service"
      and (label IN ("suse.ai.category:application", "suse.ai.category:agent", "suse.ai.category:ui")
      or not label IN ("suse.ai.category:application", "suse.ai.category:agent", "suse.ai.category:ui", "suse.ai.category:inference-engine", "suse.ai.category:model-proxy", "suse.ai.category:vectordb", "suse.ai.category:search-engine", "suse.ai.category:mcp-server", "suse.ai.category:workflow-engine", "suse.ai.category:ml-registry"))
  rank:
    specificity: 225
  presentation:
    overview:
      name:
        singular: application
        plural: applications
        title: Applications & agents
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: otel_name
        title: Name
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: otel_namespace
        title: Service namespace
        projection:
          _type: TextProjection
          value: tags.singleValue('service.namespace')
      - columnId: suse_ai_category
      - columnId: otel_k8s_cluster
      sort:
      - columnId: health
      - columnId: otel_name
      mainMenu:
        group: SUSE AI
        icon: !icon menu/agent.svg
        order: 90
