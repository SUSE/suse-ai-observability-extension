nodes:
- _type: ComponentPresentation
  name: SUSE AI common fields
  identifier: urn:stackpack:suse-ai:component-presentation:common
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:suse-ai"
  rank:
    specificity: 200
  presentation:
    icon: !icon application.svg
    filters:
    - filterId: k8s_cluster
      displayName:
        singular: K8s cluster
        plural: K8s clusters
      filter:
        _type: TagFilter
        tagKey: cluster-name
      menuSection: K8s
    - filterId: otel_namespace
      displayName:
        singular: Service namespace
        plural: Service namespaces
      filter:
        _type: TagFilter
        tagKey: service.namespace
      menuSection: SUSE AI
    - filterId: suse_ai_suse_ai_category
      displayName:
        singular: Category
        plural: Categories
      filter:
        _type: TagFilter
        tagKey: suse.ai.category
      menuSection: SUSE AI
    - filterId: suse_ai_suse_ai_product
      displayName:
        singular: Product
        plural: Products
      filter:
        _type: TagFilter
        tagKey: suse.ai.product
      menuSection: SUSE AI
    - filterId: suse_ai_gen_ai_provider_name
      displayName:
        singular: Provider
        plural: Providers
      filter:
        _type: TagFilter
        tagKey: gen_ai.provider.name
      menuSection: SUSE AI
    overview:
      name:
        singular: AI component
        plural: AI components
        title: AI components
      columns:
      - columnId: suse_ai_category
        title: Category
        projection:
          _type: TextProjection
          value: >-
            'suse.ai.category' in tags && size(tags['suse.ai.category']) > 0 ?
            tags['suse.ai.category'].map(category, category in {'application': 'Application', 'agent': 'Agent
            service', 'ui': 'AI interface', 'inference-engine': 'Inference', 'model-proxy': 'Model gateway',
            'vectordb': 'Vector database', 'search-engine': 'Search', 'mcp-server': 'MCP server',
            'workflow-engine': 'Workflow', 'ml-registry': 'Model registry'} ? {'application': 'Application',
            'agent': 'Agent service', 'ui': 'AI interface', 'inference-engine': 'Inference', 'model-proxy':
            'Model gateway', 'vectordb': 'Vector database', 'search-engine': 'Search', 'mcp-server': 'MCP
            server', 'workflow-engine': 'Workflow', 'ml-registry': 'Model registry'}[category] :
            category).join(', ') : ('vllm.model.name' in tags ? 'Model deployment' : ('gen_ai.agent.name' in
            tags ? 'Agent' : ('gen_ai.request.model' in tags ? 'Model usage' : 'Application')))
      - columnId: suse_ai_product
        title: Product
        projection:
          _type: TextProjection
          value: "'suse.ai.product' in tags ? tags['suse.ai.product'].join(', ') : ''"
      - columnId: otel_k8s_cluster
        title: Cluster
        projection:
          _type: TextProjection
          # A canonical OTel service can span multiple Kubernetes clusters.
          value: "'cluster-name' in tags ? tags['cluster-name'].filter(cluster, cluster != '').join(', ') : ''"
      - columnId: suse_ai_observer_service
        title: Calling service
        projection:
          _type: TextProjection
          value: "tags.singleValue('suse.ai.discovery') == 'client-observed' ? tags.singleValue('service.name') : ''"
      - columnId: suse_ai_observer_cluster
        title: Observed from cluster
        projection:
          _type: TextProjection
          value: tags.singleValue('suse.ai.observer.cluster')
