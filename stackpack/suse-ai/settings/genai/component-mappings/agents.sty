nodes:
- _type: OtelComponentMapping
  identifier: urn:stackpack:suse-ai:otel-component-mapping:agents
  name: Logical AI agents
  description: Named agents scoped to a service, never invocation IDs.
  input:
    signal:
    - TRACES
    resource:
      condition: '''service.name'' in resource.attributes && resource.attributes[''service.name''] != '''' && !(''suse.ai.managed''
        in resource.attributes && string(resource.attributes[''suse.ai.managed'']) == ''false'')'
      scope:
        span:
          condition: ('gen_ai.agent.name' in span.attributes && span.attributes['gen_ai.agent.name'] != '') || ('traceloop.span.kind'
            in span.attributes && span.attributes['traceloop.span.kind'] == 'agent' && 'traceloop.entity.name' in span.attributes
            && span.attributes['traceloop.entity.name'] != '')
          action: '''CREATE'''
  vars:
  - name: namespace
    value: '''service.namespace'' in resource.attributes && resource.attributes[''service.namespace''] != '''' ? resource.attributes[''service.namespace'']
      : ''default'''
  - name: service
    value: resource.attributes['service.name']
  - name: agent
    value: >-
      'gen_ai.agent.name' in span.attributes && span.attributes['gen_ai.agent.name'] != ''
      ? string(span.attributes['gen_ai.agent.name']) : string(span.attributes['traceloop.entity.name'])
  expireAfter: 900000
  rank:
    specificity: 150
  output:
    # Values are unescaped; embedded field separators can collide (see the example README).
    identifier: >-
      'urn:suse-ai:namespace/' + vars.namespace + ':service/' + vars.service
      + ':agent/' + vars.agent
    name: vars.agent
    typeName: '''genai agent'''
    required:
      tags:
      - source: '''suse-ai'''
        target: stackpack
      - source: vars.namespace
        target: service.namespace
      - source: vars.service
        target: service.name
      - source: vars.namespace
        target: suse.ai.metric.service_namespace
      - source: vars.service
        target: suse.ai.metric.service_name
      - source: vars.agent
        target: gen_ai.agent.name
      # Informational cluster membership does not change the native identity scope.
      - source: >-
          'k8s.cluster.name' in resource.attributes && resource.attributes['k8s.cluster.name'] != ''
          ? {'cluster-name': resource.attributes['k8s.cluster.name']} : {}
        pattern: '^(.*)$'
        target: '${1}'
