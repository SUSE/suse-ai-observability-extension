nodes:
- _type: Monitor
  name: GPU Node NVIDIA XID Errors
  identifier: urn:stackpack:suse-ai:monitor:nvidia-xid-errors
  description: Detects NVIDIA XID errors on a GPU node. Uses the exporter windowed error count when available and falls back to the last XID code for older exporters.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 1.0
    comparator: GTE
    failureState: CRITICAL
    metric:
      aliasTemplate: NVIDIA XID error
      query: >-
        max by (k8s_cluster_name, k8s_node_name) (
          max_over_time(DCGM_EXP_XID_ERRORS_COUNT{k8s_cluster_name!="", k8s_node_name!="", xid!="0"}[5m])
          or (0 * max_over_time(DCGM_EXP_XID_ERRORS_COUNT{k8s_cluster_name!="", k8s_node_name!="", xid="0"}[5m]))
        )
        or max by (k8s_cluster_name, k8s_node_name) (
          max_over_time(DCGM_FI_DEV_XID_ERRORS{k8s_cluster_name!="", k8s_node_name!=""}[5m])
        )
      unit: short
    titleTemplate: NVIDIA XID error
    urnTemplate: urn:kubernetes:/${k8s_cluster_name}:node/${k8s_node_name}
