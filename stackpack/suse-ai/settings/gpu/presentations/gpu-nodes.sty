nodes:
- _type: ComponentPresentation
  name: Gpu Nodes
  identifier: urn:stackpack:suse-ai:component-presentation:gpu-nodes
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label IN ("nvidia.com/gpu.present:true") AND type IN ("node"))
  rank:
    specificity: 240
  presentation:
    metricPerspective:
      tabs:
      - tabId: suse-ai-gpu
        title: GPU
        order: 50
        sections:
        - sectionId: suse-ai-gpu-temperature
          title: Temperature
          order: 50
          metrics:
          - metricId: suse-ai-common-node-gpu-avg-temp
            order: 100
          - metricId: suse-ai-common-node-gpu-temperature
            order: 98
        - sectionId: suse-ai-gpu-power
          title: Power
          order: 49
          metrics:
          - metricId: suse-ai-common-node-gpu-power-total
            order: 99
          - metricId: suse-ai-common-node-gpu-power-usage
            order: 97
          - metricId: suse-ai-common-node-gpu-average-power-draw
            order: 90
        - sectionId: suse-ai-gpu-utilization
          title: Utilization
          order: 48
          metrics:
          - metricId: suse-ai-common-node-gpu-sm-clocks
            order: 96
          - metricId: suse-ai-common-node-gpu-utilization
            order: 95
          - metricId: suse-ai-common-node-gpu-tensor-core-utilization
            order: 94
          - metricId: suse-ai-common-node-gpu-framebuffer-mem-used
            order: 93
          - metricId: suse-ai-common-node-gpu-average-utilization
            order: 92
          - metricId: suse-ai-common-node-gpu-memory-utilization
            order: 91
          - metricId: suse-ai-common-node-vgpu-utilization
            order: 89
          - metricId: suse-ai-common-node-vgpu-utilization-by-container
            order: 88
          - metricId: suse-ai-common-node-vgpu-memory-usage
            order: 87
        - sectionId: suse-ai-gpu-host
          title: Host resources
          order: 40
          metrics: &id001
          - metricId: suse-ai-common-node-host-cpu
            order: 100
          - metricId: suse-ai-common-node-host-memory
            order: 99
    summary:
      metrics:
      - summaryMetricId: suse-ai-common-node-gpu-avg-temp-summary
        name: GPU Temperature Average
        metricId: suse-ai-common-node-gpu-avg-temp
        order: 100
        unit: celsius
        decimalPlaces: 2
        query: avg(DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
          k8s_node_name="${name}" })
      - summaryMetricId: suse-ai-common-node-gpu-power-total-summary
        name: GPU Power Total
        metricId: suse-ai-common-node-gpu-power-total
        order: 99
        unit: watt
        decimalPlaces: 2
        query: |-
          sum(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" })
      - summaryMetricId: suse-ai-common-node-gpu-temperature-summary
        name: GPU Temperature
        metricId: suse-ai-common-node-gpu-temperature
        order: 98
        unit: celsius
        decimalPlaces: 2
        query: DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
          k8s_node_name="${name}" }
      - summaryMetricId: suse-ai-common-node-gpu-power-usage-summary
        name: GPU Power Usage
        metricId: suse-ai-common-node-gpu-power-usage
        order: 97
        unit: watt
        decimalPlaces: 2
        query: DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
          k8s_node_name="${name}" }
    overview:
      name:
        singular: GPU node
        plural: GPU nodes
        title: GPU infrastructure
      mainMenu:
        icon: !icon menu/gpu.svg
        group: SUSE AI
        order: 40
      columns:
      - columnId: health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: suse_ai_name
        title: Node
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_gpu_model
        title: GPU model
        projection:
          _type: TextProjection
          value: tags.singleValue('nvidia.com/gpu.product')
      - columnId: suse_ai_gpu_count
        title: GPUs
        projection:
          _type: TextProjection
          value: tags.singleValue('nvidia.com/gpu.count')
      - columnId: suse_ai_gpu_memory
        title: Memory / GPU
        projection:
          _type: NumericProjection
          value: double(tags.singleValue('nvidia.com/gpu.memory')) * 1048576.0
          unit: bytes
          decimalPlaces: 0
      - columnId: suse_ai_gpu_utilization
        title: GPU utilization
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: percent
          query: avg by (k8s_cluster_name, k8s_node_name)
            (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}"})
          metricId: suse-ai-common-node-gpu-utilization
      - columnId: suse_ai_gpu_memory_utilization
        title: Memory used
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: percent
          query: 100 * sum by (k8s_cluster_name, k8s_node_name)
            (DCGM_FI_DEV_FB_USED{k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}"})
            / sum by (k8s_cluster_name, k8s_node_name)
            (DCGM_FI_DEV_FB_USED{k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}"} +
            DCGM_FI_DEV_FB_FREE{k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}"})
          metricId: suse-ai-common-node-gpu-memory-utilization
      - columnId: suse_ai_gpu_temperature
        title: Temperature
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: celsius
          query: avg by (k8s_cluster_name, k8s_node_name)
            (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}"})
          metricId: suse-ai-common-node-gpu-avg-temp
      - columnId: suse_ai_gpu_power
        title: Power
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: watt
          query: sum by (k8s_cluster_name, k8s_node_name)
            (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name="${tags.singleValue('cluster-name')}",
            k8s_node_name="${name}"})
          metricId: suse-ai-common-node-gpu-power-total
      - columnId: suse-ai-common-node-host-cpu
        title: Host CPU usage
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: percent
          query: "avg by (sts_host) (system_cpu_user{sts_host=\"${'sts_host' in properties ? properties.sts_host : ''}\"\
            , sts_host!=\"\"} + system_cpu_system{sts_host=\"${'sts_host' in properties ? properties.sts_host : ''}\"\
            , sts_host!=\"\"})"
          metricId: suse-ai-common-node-host-cpu
      - columnId: suse-ai-common-node-host-memory
        title: Usable host memory
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 1
          unit: bytes
          query: "max by (sts_host) (system_mem_usable{sts_host=\"${'sts_host' in properties ? properties.sts_host :
            ''}\", sts_host!=\"\"}) * 1048576"
          metricId: suse-ai-common-node-host-memory
      - columnId: suse_ai_cluster
        title: Cluster
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('cluster-name')
          identifier: "'urn:cluster:/kubernetes:' + tags.singleValue('cluster-name')"
      sort:
      - columnId: health
      - columnId: suse_ai_name
      fixedColumns: 2
    highlight:
      fields:
      - fieldId: suse_ai_gpu_model
        title: GPU model
        order: 50
        projection:
          _type: TextProjection
          value: "'nvidia.com/gpu.product' in tags ? tags.singleValue('nvidia.com/gpu.product') : ''"
      - fieldId: suse_ai_gpu_count
        title: Physical GPUs
        order: 49
        projection:
          _type: TextProjection
          value: "'nvidia.com/gpu.count' in tags ? tags.singleValue('nvidia.com/gpu.count') : ''"
      - fieldId: suse_ai_gpu_family
        title: GPU family
        order: 48
        projection:
          _type: TextProjection
          value: "'nvidia.com/gpu.family' in tags ? tags.singleValue('nvidia.com/gpu.family') : ''"
      - fieldId: suse_ai_gpu_sharing
        title: Sharing strategy
        order: 47
        projection:
          _type: TextProjection
          value: "'nvidia.com/gpu.sharing-strategy' in tags ? tags.singleValue('nvidia.com/gpu.sharing-strategy') : ''"
      - fieldId: suse_ai_gpu_replicas
        title: Scheduling slots per GPU
        order: 46
        projection:
          _type: TextProjection
          value: "'nvidia.com/gpu.replicas' in tags ? tags.singleValue('nvidia.com/gpu.replicas') : ''"
      - fieldId: suse_ai_gpu_cuda
        title: CUDA runtime
        order: 45
        projection:
          _type: TextProjection
          value: "'nvidia.com/cuda.runtime-version.full' in tags ? tags.singleValue('nvidia.com/cuda.runtime-version.full')
            : ''"
      - fieldId: suse_ai_gpu_driver
        title: Driver version
        order: 44
        projection:
          _type: TextProjection
          value: "'nvidia.com/cuda.driver-version.full' in tags ? tags.singleValue('nvidia.com/cuda.driver-version.full')
            : ''"
      - fieldId: suse_ai_gpu_os
        title: Node OS
        order: 43
        projection:
          _type: TextProjection
          value: "'feature.node.kubernetes.io/system-os_release.ID' in tags ? tags.singleValue('feature.node.kubernetes.io/system-os_release.ID')
            : ''"
      - fieldId: suse_ai_gpu_os_version
        title: OS version
        order: 42
        projection:
          _type: TextProjection
          value: "'feature.node.kubernetes.io/system-os_release.VERSION_ID' in tags ? tags.singleValue('feature.node.kubernetes.io/system-os_release.VERSION_ID')
            : ''"
      metrics:
      - sectionId: suse-ai-gpu-host
        title: Host resources
        order: 50
        metrics: *id001
  metrics:
  - metricId: suse-ai-common-node-gpu-avg-temp
    name: GPU Temperature Average
    metricQueries:
    - expression: avg(DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
        k8s_node_name="${name}" })
      alias: Temperature
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: celsius
  - metricId: suse-ai-common-node-gpu-power-total
    name: GPU Power Total
    metricQueries:
    - expression: |-
        sum(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" })
      alias: Power
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-node-gpu-temperature
    name: GPU Temperature
    metricQueries:
    - expression: DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
        k8s_node_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: celsius
  - metricId: suse-ai-common-node-gpu-power-usage
    name: GPU Power Usage
    metricQueries:
    - expression: DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
        k8s_node_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-node-gpu-sm-clocks
    name: GPU SM Clocks
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_SM_CLOCK{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" } * 1000000
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: hertz
  - metricId: suse-ai-common-node-gpu-utilization
    name: GPU Utilization
    metricQueries:
    - expression: DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
        k8s_node_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-gpu-tensor-core-utilization
    name: Tensor Core Utilization
    metricQueries:
    - expression: |-
        DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse-ai-common-node-gpu-framebuffer-mem-used
    name: GPU Framebuffer Mem Used
    metricQueries:
    - expression: DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}",
        k8s_node_name="${name}" } * 1048576
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
  - metricId: suse-ai-common-node-gpu-average-utilization
    name: Average GPU Utilization
    metricQueries:
    - expression: |-
        avg_over_time(DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" }[${__rate_interval}])
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-gpu-memory-utilization
    name: GPU Memory Utilisation (%)
    metricQueries:
    - expression: |-
        100 * (DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" }) / (DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" } + DCGM_FI_DEV_FB_FREE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" })
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-gpu-average-power-draw
    name: Average Power Draw
    metricQueries:
    - expression: |-
        avg_over_time(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}" }[${__rate_interval}])
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-node-vgpu-utilization
    name: vGPU Utilization
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}", vgpu!="" }
      alias: GPU ${gpu} / vGPU ${vgpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-vgpu-utilization-by-container
    name: vGPU Utilization by Container
    metricQueries:
    - expression: |-
        max by (pod_namespace, pod_name, container_name, gpu, vgpu) (DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}", vgpu!="" })
      alias: ${pod_namespace}/${pod_name}/${container_name} (GPU ${gpu} / vGPU ${vgpu})
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-vgpu-memory-usage
    name: vGPU Memory Usage
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${name}", vgpu!="" } * 1048576
      alias: GPU ${gpu} / vGPU ${vgpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
  - metricId: suse-ai-common-node-host-cpu
    name: Host CPU usage
    metricQueries:
    - expression: "avg by (sts_host) (system_cpu_user{sts_host=\"${'sts_host' in properties ? properties.sts_host : ''}\"\
        , sts_host!=\"\"} + system_cpu_system{sts_host=\"${'sts_host' in properties ? properties.sts_host : ''}\", sts_host!=\"\
        \"})"
      alias: Host CPU usage
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-node-host-memory
    name: Usable host memory
    metricQueries:
    - expression: "max by (sts_host) (system_mem_usable{sts_host=\"${'sts_host' in properties ? properties.sts_host :
        ''}\", sts_host!=\"\"}) * 1048576"
      alias: Usable host memory
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
