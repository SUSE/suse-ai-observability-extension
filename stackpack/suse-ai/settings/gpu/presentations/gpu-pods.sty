nodes:
- _type: ComponentPresentation
  name: Gpu Pods
  identifier: urn:stackpack:suse-ai:component-presentation:gpu-pods
  binding:
    _type: ComponentPresentationQueryBinding
    query: type = "pod" AND label = "stackpack:kubernetes" AND label = "suse.ai.gpu.telemetry:dcgm"
  rank:
    specificity: 240
  presentation:
    metricPerspective:
      tabs:
      - tabId: suse-ai-gpu
        title: GPU
        order: 50
        sections:
        - sectionId: suse-ai-gpu-temperature
          title: Temperature
          order: 50
          metrics:
          - metricId: suse-ai-common-pod-gpu-avg-temp
            order: 100
          - metricId: suse-ai-common-pod-gpu-temperature
            order: 98
        - sectionId: suse-ai-gpu-power
          title: Power
          order: 49
          metrics:
          - metricId: suse-ai-common-pod-gpu-power-total
            order: 99
          - metricId: suse-ai-common-pod-gpu-power-usage
            order: 97
          - metricId: suse-ai-common-pod-gpu-average-power-draw
            order: 90
        - sectionId: suse-ai-gpu-utilization
          title: Utilization
          order: 48
          metrics:
          - metricId: suse-ai-common-pod-gpu-sm-clocks
            order: 96
          - metricId: suse-ai-common-pod-gpu-utilization
            order: 95
          - metricId: suse-ai-common-pod-gpu-tensor-core-utilization
            order: 94
          - metricId: suse-ai-common-pod-gpu-framebuffer-mem-used
            order: 93
          - metricId: suse-ai-common-pod-gpu-average-utilization
            order: 92
          - metricId: suse-ai-common-pod-gpu-memory-utilization
            order: 91
          - metricId: suse-ai-common-pod-vgpu-utilization
            order: 89
          - metricId: suse-ai-common-pod-vgpu-utilization-by-container
            order: 88
          - metricId: suse-ai-common-pod-vgpu-memory-usage
            order: 87
    summary:
      metrics:
      - summaryMetricId: suse-ai-common-pod-gpu-avg-temp-summary
        name: GPU Temperature Average
        metricId: suse-ai-common-pod-gpu-avg-temp
        order: 100
        unit: celsius
        decimalPlaces: 2
        query: |-
          avg(DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" })
      - summaryMetricId: suse-ai-common-pod-gpu-power-total-summary
        name: GPU Power Total
        metricId: suse-ai-common-pod-gpu-power-total
        order: 99
        unit: watt
        decimalPlaces: 2
        query: |-
          sum(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" })
      - summaryMetricId: suse-ai-common-pod-gpu-temperature-summary
        name: GPU Temperature
        metricId: suse-ai-common-pod-gpu-temperature
        order: 98
        unit: celsius
        decimalPlaces: 2
        query: |-
          DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
      - summaryMetricId: suse-ai-common-pod-gpu-power-usage-summary
        name: GPU Power Usage
        metricId: suse-ai-common-pod-gpu-power-usage
        order: 97
        unit: watt
        decimalPlaces: 2
        query: |-
          DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
  metrics:
  - metricId: suse-ai-common-pod-gpu-avg-temp
    name: GPU Temperature Average
    metricQueries:
    - expression: |-
        avg(DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" })
      alias: Temperature
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: celsius
  - metricId: suse-ai-common-pod-gpu-power-total
    name: GPU Power Total
    metricQueries:
    - expression: |-
        sum(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" })
      alias: Power
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-pod-gpu-temperature
    name: GPU Temperature
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_GPU_TEMP{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: celsius
  - metricId: suse-ai-common-pod-gpu-power-usage
    name: GPU Power Usage
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-pod-gpu-sm-clocks
    name: GPU SM Clocks
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_SM_CLOCK{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" } * 1000000
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: hertz
  - metricId: suse-ai-common-pod-gpu-utilization
    name: GPU Utilization
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-pod-gpu-tensor-core-utilization
    name: Tensor Core Utilization
    metricQueries:
    - expression: |-
        DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse-ai-common-pod-gpu-framebuffer-mem-used
    name: GPU Framebuffer Mem Used
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" } * 1048576
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
  - metricId: suse-ai-common-pod-gpu-average-utilization
    name: Average GPU Utilization
    metricQueries:
    - expression: |-
        avg_over_time(DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }[${__rate_interval}])
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-pod-gpu-memory-utilization
    name: GPU Memory Utilisation (%)
    metricQueries:
    - expression: |-
        100 * (DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }) / (DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" } + DCGM_FI_DEV_FB_FREE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" })
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-pod-gpu-average-power-draw
    name: Average Power Draw
    metricQueries:
    - expression: |-
        avg_over_time(DCGM_FI_DEV_POWER_USAGE{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}" }[${__rate_interval}])
      alias: GPU ${gpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
  - metricId: suse-ai-common-pod-vgpu-utilization
    name: vGPU Utilization
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}", vgpu!="" }
      alias: GPU ${gpu} / vGPU ${vgpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-pod-vgpu-utilization-by-container
    name: vGPU Utilization by Container
    metricQueries:
    - expression: |-
        max by (container_name, gpu, vgpu) (DCGM_FI_DEV_GPU_UTIL{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}", vgpu!="" })
      alias: ${container_name} (GPU ${gpu} / vGPU ${vgpu})
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse-ai-common-pod-vgpu-memory-usage
    name: vGPU Memory Usage
    metricQueries:
    - expression: |-
        DCGM_FI_DEV_FB_USED{ k8s_cluster_name="${tags.singleValue('cluster-name')}", k8s_node_name="${tags.singleValue('node-name')}", pod_namespace="${tags.singleValue('namespace')}", pod_name="${name}", vgpu!="" } * 1048576
      alias: GPU ${gpu} / vGPU ${vgpu}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
