nodes:
- _type: ComponentPresentation
  name: GPU devices
  identifier: urn:stackpack:suse-ai:component-presentation:gpus
  binding:
    _type: ComponentPresentationQueryBinding
    query: type = "genai gpu" and label = "stackpack:suse-ai"
  rank:
    specificity: 220
  presentation:
    icon: !icon 'outline/gpu.svg'
    overview:
      name:
        singular: GPU
        plural: GPUs
        title: GPUs
      columns:
      - columnId: suse_ai_gpu_uuid
        title: GPU
        projection:
          _type: ComponentLinkProjection
          name: name
          identifier: identifiers[0]
      - columnId: suse_ai_gpu_model
        title: Model
        projection:
          _type: TextProjection
          value: tags.singleValue('gpu.model')
      - columnId: suse_ai_gpu_node
        title: Node
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('gpu.node')
          identifier: '''urn:kubernetes:/'' + tags.singleValue(''cluster-name'') + '':node/'' + tags.singleValue(''gpu.node'')'
      - columnId: suse_ai_gpu_cluster
        title: Cluster
        projection:
          _type: TextProjection
          value: tags.singleValue('cluster-name')
    highlight:
      title: GPU device
      fields:
      - fieldId: suse_ai_gpu_model
        title: Model
        order: 1
        projection:
          _type: TextProjection
          value: tags.singleValue('gpu.model')
      - fieldId: suse_ai_gpu_uuid
        title: Device UUID
        order: 2
        projection:
          _type: TextProjection
          value: tags.singleValue('gpu.uuid')
      relatedResources:
      - resourceId: suse_ai_allocated_pods
        title: Allocated pods
        order: 2
        topologyQuery: withNeighborsOf(direction = "down", components = (identifier = "${identifiers[0]}"), levels
          = "1") and type = "pod"
      - resourceId: suse_ai_gpu_node
        title: Node
        order: 1
        topologyQuery: withNeighborsOf(direction = "down", components = (identifier = "${identifiers[0]}"), levels
          = "1") and type = "node"
        presentationIdentifier: urn:stackpack:suse-ai:component-presentation:gpu-nodes
      metrics:
      - sectionId: suse_ai_gpu_device_hardware
        title: GPU hardware
        order: 100
        metrics:
        - metricId: suse_ai_gpu_device_utilization
          order: 100
        - metricId: suse_ai_gpu_device_temperature
          order: 99
        - metricId: suse_ai_gpu_device_memory_used
          order: 98
        - metricId: suse_ai_gpu_device_memory_free
          order: 97
        - metricId: suse_ai_gpu_device_power
          order: 96
    metricPerspective:
      tabs:
      - tabId: suse_ai_gpu_device_hardware
        title: GPU hardware
        order: 100
        sections:
        - sectionId: suse_ai_gpu_device_hardware
          title: GPU hardware
          order: 100
          metrics:
          - metricId: suse_ai_gpu_device_utilization
            order: 100
          - metricId: suse_ai_gpu_device_temperature
            order: 99
          - metricId: suse_ai_gpu_device_memory_used
            order: 98
          - metricId: suse_ai_gpu_device_memory_free
            order: 97
          - metricId: suse_ai_gpu_device_power
            order: 96
  metrics:
  - metricId: suse_ai_gpu_device_utilization
    name: GPU utilization
    metricQueries:
    - expression: max(DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name="${tags.singleValue('cluster-name')}", UUID="${tags.singleValue('gpu.uuid')}",
        GPU_I_ID="", GPU_I_PROFILE=""})
      alias: Device
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse_ai_gpu_device_temperature
    name: GPU temperature
    metricQueries:
    - expression: max(DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name="${tags.singleValue('cluster-name')}", UUID="${tags.singleValue('gpu.uuid')}",
        GPU_I_ID="", GPU_I_PROFILE=""})
      alias: Device
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: celsius
  - metricId: suse_ai_gpu_device_memory_used
    name: Framebuffer used
    metricQueries:
    - expression: max(DCGM_FI_DEV_FB_USED{k8s_cluster_name="${tags.singleValue('cluster-name')}", UUID="${tags.singleValue('gpu.uuid')}",
        GPU_I_ID="", GPU_I_PROFILE=""}) * 1048576
      alias: Device
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
  - metricId: suse_ai_gpu_device_memory_free
    name: Framebuffer free
    metricQueries:
    - expression: min(DCGM_FI_DEV_FB_FREE{k8s_cluster_name="${tags.singleValue('cluster-name')}", UUID="${tags.singleValue('gpu.uuid')}",
        GPU_I_ID="", GPU_I_PROFILE=""}) * 1048576
      alias: Device
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
  - metricId: suse_ai_gpu_device_power
    name: GPU power
    metricQueries:
    - expression: max(DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name="${tags.singleValue('cluster-name')}", UUID="${tags.singleValue('gpu.uuid')}",
        GPU_I_ID="", GPU_I_PROFILE=""})
      alias: Device
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: watt
