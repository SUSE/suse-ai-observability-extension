# Generated by scripts/dashboards-icons/build_dashboards.py; edit that source.
nodes:
- _type: Dashboard
  identifier: urn:stackpack:suse-ai:shared:dashboard:overview
  name: SUSE AI — Overview
  description: Are AI calls completing promptly, and is serving capacity under pressure?
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        about:
          spec:
            display:
              name: About / How to read
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Overview** · [Model serving](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:model-serving)
                  · [Gateway & spend](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gateway-spend) · [GPU fleet](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gpu-fleet)


                  Are AI calls completing promptly, and is serving capacity under pressure? **How to read:** Start with Right
                  now, then compare the same five-minute window with one hour earlier. Blue values describe load; they do
                  not assert health. Gaps mean no usable samples or no traffic.'
            queries: []
            links: []
        gateway-requests:
          spec:
            display:
              name: Gateway requests / min
              description: LiteLLM proxy requests, including failures.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user,
                      hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code,
                      user_email, route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status,
                      le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        gateway-failed:
          spec:
            display:
              name: Gateway failed (%)
              description: LiteLLM failures divided by proxy requests. Idle traffic has no error percentage.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: percent
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 100 * (sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user,
                      hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code,
                      user_email, route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status,
                      le) (rate(litellm_proxy_failed_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m]))) or (0 *
                      sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
                      api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email,
                      route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))))
                      / (sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
                      api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email,
                      route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                      > 0)
                    alias: Now
            links: []
        client-latency:
          spec:
            display:
              name: Client duration p95
              description: P95 of observed client operations, including failed calls; not server TTFT.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: s
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        gpu-util:
          spec:
            display:
              name: Mean GPU utilization
              description: Equal-weight average of reported physical GPUs, deduplicated by cluster and device.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: percent
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: avg(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        calls-compare:
          spec:
            display:
              name: Client calls / min — now vs 1 hour ago
              description: Client observations across instrumented callers; a user request may create several model calls.
                The previous hour is shifted forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum(rate(gen_ai_client_operation_duration_seconds_count{k8s_cluster_name=~"${cluster}"}[5m]))
                    alias: Now
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum(rate(gen_ai_client_operation_duration_seconds_count{k8s_cluster_name=~"${cluster}"}[5m]
                      offset 1h))
                    alias: 1 hour ago
            links: []
        vllm-tokens-compare:
          spec:
            display:
              name: vLLM generated tokens / s — now vs 1 hour ago
              description: Server-side output throughput, separate from caller token observations. The previous hour is shifted
                forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, model_name,
                      engine, finished_reason, le) (rate(vllm:generation_tokens_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, model_name,
                      engine, finished_reason, le) (rate(vllm:generation_tokens_total{k8s_cluster_name=~"${cluster}"}[5m]
                      offset 1h)))
                    alias: 1 hour ago
            links: []
        models-compare:
          spec:
            display:
              name: Ollama loaded model replicas — now vs 1 hour ago
              description: Loaded models summed across serving replicas; the same model on two replicas counts twice. The
                previous hour is shifted forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 0
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum(max by (k8s_cluster_name, service_namespace, service_name, service_instance_id) (ollama_loaded_models{k8s_cluster_name=~"${cluster}"}))
                    alias: Now
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum(max by (k8s_cluster_name, service_namespace, service_name, service_instance_id) (ollama_loaded_models{k8s_cluster_name=~"${cluster}"}
                      offset 1h))
                    alias: 1 hour ago
            links: []
        gpu-compare:
          spec:
            display:
              name: Mean GPU utilization — now vs 1 hour ago
              description: Compare utilization with calls and latency before deciding to add capacity. The previous hour is
                shifted forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: percent
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: avg(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: avg(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h))
                    alias: 1 hour ago
            links: []
        coverage:
          spec:
            display:
              name: Coverage / Next steps
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Source coverage:** LiteLLM reports gateway traffic and cost; vLLM reports server request and token
                  metrics; Ollama reports loaded models; client GenAI metrics report caller experience; DCGM reports GPU usage.
                  These are separate observation points: do not sum their request or token counts. A missing line means no
                  usable samples; an idle histogram has no meaningful percentile. New sources may have no hour-ago history.'
            queries: []
            links: []
      layouts:
      - kind: Grid
        spec:
          items:
          - x: 0
            y: 0
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/about'
          - x: 0
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-requests'
          - x: 6
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-failed'
          - x: 12
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/client-latency'
          - x: 18
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gpu-util'
          - x: 0
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/calls-compare'
          - x: 12
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/vllm-tokens-compare'
          - x: 0
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/models-compare'
          - x: 12
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/gpu-compare'
          - x: 0
            y: 9
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/coverage'
      variables:
      - kind: ListVariable
        spec:
          name: cluster
          display:
            name: Cluster
            description: Cluster reporting these metrics.
          allowMultiple: false
          allowAllValue: false
          sort: alphabetical-asc
          plugin:
            kind: MetricLabelValues
            spec:
              labelName: k8s_cluster_name
              matchers:
              - gen_ai_client_operation_duration_seconds_count
              - ollama_api_up
              - DCGM_FI_DEV_GPU_UTIL
              - litellm_proxy_requests_metric_total
              - vllm:generation_tokens_total
