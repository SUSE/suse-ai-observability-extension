# Generated by scripts/dashboards-icons/build_dashboards.py; edit that source.
nodes:
- _type: Dashboard
  identifier: urn:stackpack:suse-ai:shared:dashboard:gpu-fleet
  name: SUSE AI — GPU fleet
  description: Locate busy, memory-constrained or hot physical GPUs using DCGM telemetry.
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        about:
          spec:
            display:
              name: About / How to read
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '[Overview](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:overview) · [Model serving](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:model-serving)
                  · [Gateway & spend](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gateway-spend) · **GPU fleet**


                  Locate busy, memory-constrained or hot physical GPUs using DCGM telemetry. **How to read:** Each device
                  is identified by cluster and UUID; repeated pod/scrape copies are deduplicated. MIG slices and missing UUIDs
                  are excluded. Compare current gauges with the same devices one hour ago. Utilization is a capacity signal,
                  not a health verdict.'
            queries: []
            links: []
        gpu-count:
          spec:
            display:
              name: Reported physical GPUs
              description: Distinct reporting device identities. Missing exporters are not counted as healthy or as zero devices.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 0
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: count(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-util:
          spec:
            display:
              name: Mean GPU utilization
              description: Average of reported physical-device utilization percentages.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: percent
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: avg(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-temp:
          spec:
            display:
              name: Highest GPU temperature
              description: Highest reported temperature. Thermal limits vary by hardware; no universal alarm threshold is
                assumed.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: celsius
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-power:
          spec:
            display:
              name: Fleet power
              description: Sum after physical-device deduplication, in watts; this is not an electricity bill.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: watt
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        util-by-gpu:
          spec:
            display:
              name: GPU utilization — now vs 1 hour ago
              description: Per-device utilization. Pod attribution does not provide hardware isolation. The previous hour
                is shifted forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: percent
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""})
                    alias: Now · ${k8s_node_name} · ${UUID}
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h)
                    alias: 1 hour ago · ${k8s_node_name} · ${UUID}
            links: []
        memory-by-gpu:
          spec:
            display:
              name: Framebuffer used — now vs 1 hour ago
              description: 100 × used / (used + free), using DCGM MiB gauges. Reserved memory is outside this denominator.
                The previous hour is shifted forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: percent
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 100 * max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}) / ((max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}) + max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_FREE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""})) > 0)
                    alias: Now · ${k8s_node_name} · ${UUID}
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 100 * max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h) / ((max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h) + max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_FREE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h)) > 0)
                    alias: 1 hour ago · ${k8s_node_name} · ${UUID}
            links: []
        temp-by-gpu:
          spec:
            display:
              name: GPU temperature — now vs 1 hour ago
              description: Check cooling and vendor limits when temperature rises with load. The previous hour is shifted
                forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: celsius
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""})
                    alias: Now · ${k8s_node_name} · ${UUID}
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h)
                    alias: 1 hour ago · ${k8s_node_name} · ${UUID}
            links: []
        power-by-gpu:
          spec:
            display:
              name: GPU power — now vs 1 hour ago
              description: Compare power with utilization before investigating idle allocation. The previous hour is shifted
                forward for comparison; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: watt
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""})
                    alias: Now · ${k8s_node_name} · ${UUID}
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""} offset 1h)
                    alias: 1 hour ago · ${k8s_node_name} · ${UUID}
            links: []
        coverage:
          spec:
            display:
              name: Coverage / Next steps
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Readout:** compare rising memory usage with loaded models, then temperature with power. Open the
                  GPU inventory to inspect workload allocation.


                  **Coverage:** these panels use verified DCGM device gauges. The demo did not report XID or ECC series, so
                  this dashboard makes no claim that hardware errors are absent. This family expects the verified uppercase
                  UUID label; a different exporter label contract needs validation.'
            queries: []
            links: []
      layouts:
      - kind: Grid
        spec:
          items:
          - x: 0
