# Generated by scripts/dashboards-icons/build_dashboards.py; edit that source.
nodes:
- _type: Dashboard
  identifier: urn:stackpack:suse-ai:shared:dashboard:gpu-fleet
  name: SUSE AI — GPU fleet
  description: Locate busy, memory-constrained or hot physical GPUs using DCGM telemetry.
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        about:
          spec:
            display:
              name: About / How to read
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '[Overview](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:overview) · [Model serving](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:model-serving)
                  · [Gateway & spend](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gateway-spend) · **GPU fleet**


                  Locate busy, memory-constrained or hot physical GPUs using DCGM telemetry. **How to read:** Each device
                  is identified by cluster and UUID; repeated pod/scrape copies are deduplicated. MIG slices and missing UUIDs
                  are excluded. Legends show node and the first eight GPU UUID characters. Use Overview for the fleet''s hour-ago
                  utilization comparison. Utilization is a capacity signal, not a health verdict.'
            queries: []
            links: []
        gpu-count:
          spec:
            display:
              name: Reported physical GPUs
              description: Distinct reporting device identities. Missing exporters are not counted as healthy or as zero devices.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 0
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: count(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-util:
          spec:
            display:
              name: Mean GPU utilization
              description: Average of reported physical-device utilization percentages.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: percent
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: avg(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-temp:
          spec:
            display:
              name: Highest GPU temperature
              description: Highest reported temperature. Thermal limits vary by hardware; no universal alarm threshold is
                assumed.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: celsius
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: max(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        gpu-power:
          spec:
            display:
              name: Fleet power
              description: Sum after physical-device deduplication, in watts; this is not an electricity bill.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: watt
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}))
                    alias: Now
            links: []
        util-by-gpu:
          spec:
            display:
              name: GPU utilization
              description: Per-device utilization. Pod attribution does not provide hardware isolation. Current selected time
                window; no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: percent
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: label_replace(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_UTIL{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}), "suse_ai_device", "$1", "UUID", "GPU-(.{8}).*")
                    alias: ${k8s_node_name} · ${suse_ai_device}
            links: []
        memory-by-gpu:
          spec:
            display:
              name: Framebuffer used
              description: 100 × used / (used + free), using DCGM MiB gauges. Reserved memory is outside this denominator.
                Current selected time window; no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: percent
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: label_replace(100 * max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}) / ((max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_USED{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}) + max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_FB_FREE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""})) > 0), "suse_ai_device", "$1", "UUID", "GPU-(.{8}).*")
                    alias: ${k8s_node_name} · ${suse_ai_device}
            links: []
        temp-by-gpu:
          spec:
            display:
              name: GPU temperature
              description: Check cooling and vendor limits when temperature rises with load. Current selected time window;
                no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: celsius
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: label_replace(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_GPU_TEMP{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}), "suse_ai_device", "$1", "UUID", "GPU-(.{8}).*")
                    alias: ${k8s_node_name} · ${suse_ai_device}
            links: []
        power-by-gpu:
          spec:
            display:
              name: GPU power
              description: Compare power with utilization before investigating idle allocation. Current selected time window;
                no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: watt
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: label_replace(max by (k8s_cluster_name, UUID, k8s_node_name) (DCGM_FI_DEV_POWER_USAGE{k8s_cluster_name=~"${cluster}",
                      UUID!="", GPU_I_ID=""}), "suse_ai_device", "$1", "UUID", "GPU-(.{8}).*")
                    alias: ${k8s_node_name} · ${suse_ai_device}
            links: []
        coverage:
          spec:
            display:
              name: Coverage / Next steps
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Readout:** compare rising memory usage with loaded models, then temperature with power. Open the
                  GPU inventory to inspect workload allocation.


                  **Coverage:** these panels use verified DCGM device gauges. The demo did not report XID or ECC series, so
                  this dashboard makes no claim that hardware errors are absent. This family expects the verified uppercase
                  UUID label; a different exporter label contract needs validation.'
            queries: []
            links: []
      layouts:
      - kind: Grid
        spec:
          items:
          - x: 0
            y: 0
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/about'
          - x: 0
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gpu-count'
          - x: 6
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gpu-util'
          - x: 12
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gpu-temp'
          - x: 18
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gpu-power'
          - x: 0
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/util-by-gpu'
          - x: 12
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/memory-by-gpu'
          - x: 0
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/temp-by-gpu'
          - x: 12
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/power-by-gpu'
          - x: 0
            y: 9
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/coverage'
      variables:
      - kind: ListVariable
        spec:
          name: cluster
          display:
            name: Cluster
            description: Cluster reporting these metrics.
          allowMultiple: false
          allowAllValue: false
          sort: alphabetical-asc
          plugin:
            kind: MetricLabelValues
            spec:
              labelName: k8s_cluster_name
              matchers:
              - DCGM_FI_DEV_GPU_UTIL
