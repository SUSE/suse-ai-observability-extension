# Generated by scripts/dashboards-icons/build_dashboards.py; edit that source.
nodes:
- _type: Dashboard
  identifier: urn:stackpack:suse-ai:shared:dashboard:model-serving
  name: SUSE AI — Model serving
  description: Compare vLLM serving latency and throughput, Ollama residency, and client GenAI experience.
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        about:
          spec:
            display:
              name: About / How to read
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '[Overview](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:overview) · **Model serving** · [Gateway
                  & spend](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gateway-spend) · [GPU fleet](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gpu-fleet)


                  Compare vLLM serving latency and throughput, Ollama residency, and client GenAI experience. **How to read:**
                  Client duration includes the caller-to-provider path. Model names remain as reported; caller names are not
                  joined to server inventory. Ollama memory and context describe loaded models, not token throughput.'
            queries: []
            links: []
        vllm-finished:
          spec:
            display:
              name: vLLM finished requests / min
              description: All observed finish reasons, including abort/error; the metric name alone does not imply success.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, model_name,
                      engine, finished_reason, le) (rate(vllm:request_success_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        vllm-ttft:
          spec:
            display:
              name: vLLM first token p95
              description: Histogram estimate over five minutes. Bucket boundaries can keep p95 flat even when individual
                requests vary; idle histograms have no percentile.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: s
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (max by (k8s_cluster_name, service_namespace, service_name,
                      service_instance_id, model_name, engine, finished_reason, le) (rate(vllm:time_to_first_token_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m]))))
                    alias: Now
            links: []
        loaded-models:
          spec:
            display:
              name: Ollama loaded model replicas
              description: Loaded-model count across live serving replicas, not available disk inventory.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 0
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum(max by (k8s_cluster_name, service_namespace, service_name, service_instance_id) (ollama_loaded_models{k8s_cluster_name=~"${cluster}"}))
                    alias: Now
            links: []
        client-latency:
          spec:
            display:
              name: Client duration p95
              description: Caller-to-provider duration including failed calls; separate from server first-token latency.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: s
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        vllm-ttft-compare:
          spec:
            display:
              name: vLLM first token p95 by model
              description: 'Histogram estimate: a flat percentile can reflect bucket resolution, not identical request durations.
                Current selected time window; no shifted historical series.'
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: s
                    decimalPlaces: 3
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (service_namespace, service_name, model_name, le) (max by (k8s_cluster_name,
                      service_namespace, service_name, service_instance_id, model_name, engine, finished_reason, le) (rate(vllm:time_to_first_token_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m]))))
                    alias: ${service_namespace}/${service_name} · ${model_name}
            links: []
        vllm-tokens:
          spec:
            display:
              name: vLLM generated tokens / s
              description: Aggregate real serving replicas after deduplicating scrape copies. Current selected time window;
                no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum by (service_namespace, service_name, model_name) (max by (k8s_cluster_name, service_namespace,
                      service_name, service_instance_id, model_name, engine, finished_reason, le) (rate(vllm:generation_tokens_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: ${service_namespace}/${service_name} · ${model_name}
            links: []
        caller-latency:
          spec:
            display:
              name: Client p95 by caller and model
              description: Use caller and requested-model labels to locate slow observations. Current selected time window;
                no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: s
                    decimalPlaces: 2
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (service_namespace, service_name, gen_ai_provider_name, gen_ai_request_model,
                      le) (rate(gen_ai_client_operation_duration_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: ${service_namespace}/${service_name} · ${gen_ai_provider_name}/${gen_ai_request_model}
            links: []
        client-tokens:
          spec:
            display:
              name: Client input / output tokens per second
              description: Rates use the token histogram sum, not its observation count. Current selected time window; no
                shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum by (service_namespace, service_name, gen_ai_provider_name, gen_ai_request_model, gen_ai_token_type)
                      (rate(gen_ai_client_token_usage_sum{k8s_cluster_name=~"${cluster}"}[5m]))
                    alias: ${service_namespace}/${service_name} · ${gen_ai_provider_name}/${gen_ai_request_model} · ${gen_ai_token_type}
            links: []
        ollama-vram:
          spec:
            display:
              name: Ollama model VRAM
              description: Per loaded model and serving replica. Missing model series does not establish deletion or zero
                memory. Current selected time window; no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: bytes
                    decimalPlaces: 2
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: label_replace(max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, model)
                      (ollama_model_vram_bytes{k8s_cluster_name=~"${cluster}"}), "suse_ai_replica", "$1", "service_instance_id",
                      "(.{8}).*")
                    alias: ${model} · ${service_namespace}/${service_name} · ${suse_ai_replica}
            links: []
        vllm-ttft-total-compare:
          spec:
            display:
              name: vLLM first token p95 — now vs 1 hour ago
              description: All observed vLLM models. Histogram interpolation can produce a flat p95 within a broad bucket.
                Dark blue is Now when both periods have data. The previous hour is shifted forward; gaps remain gaps.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: s
                    decimalPlaces: 3
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (max by (k8s_cluster_name, service_namespace, service_name,
                      service_instance_id, model_name, engine, finished_reason, le) (rate(vllm:time_to_first_token_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m]
                      offset 1h))))
                    alias: 1h ago
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (max by (k8s_cluster_name, service_namespace, service_name,
                      service_instance_id, model_name, engine, finished_reason, le) (rate(vllm:time_to_first_token_seconds_bucket{k8s_cluster_name=~"${cluster}"}[5m]))))
                    alias: Now
            links: []
        coverage:
          spec:
            display:
              name: Coverage / Next steps
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Investigate:** compare first-token latency and output throughput on vLLM, then caller latency by
                  model. For Ollama, check loaded-model count and VRAM before investigating model residency. **Histogram resolution:**
                  if all requests land in the 40–60 ms bucket, p95 is estimated at 59 ms. That does not mean every request
                  took 59 ms. Replica labels show the first eight identity characters. The verified vLLM inventory did not
                  expose queue or KV-cache gauges, so these panels do not infer them.


                  **Source coverage:** LiteLLM reports gateway traffic and cost; vLLM reports server request and token metrics;
                  Ollama reports loaded models; client GenAI metrics report caller experience; DCGM reports GPU usage. These
                  are separate observation points: do not sum their request or token counts. A missing line means no usable
                  samples; an idle histogram has no meaningful percentile. New sources may have no hour-ago history.'
            queries: []
            links: []
      layouts:
      - kind: Grid
        spec:
          items:
          - x: 0
            y: 0
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/about'
          - x: 0
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/vllm-finished'
          - x: 6
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/vllm-ttft'
          - x: 12
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/loaded-models'
          - x: 18
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/client-latency'
          - x: 0
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/vllm-ttft-compare'
          - x: 12
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/vllm-tokens'
          - x: 0
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/caller-latency'
          - x: 12
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/client-tokens'
          - x: 0
            y: 9
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/ollama-vram'
          - x: 12
            y: 9
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/vllm-ttft-total-compare'
          - x: 0
            y: 12
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/coverage'
      variables:
      - kind: ListVariable
        spec:
          name: cluster
          display:
            name: Cluster
            description: Cluster reporting these metrics.
          allowMultiple: false
          allowAllValue: false
          sort: alphabetical-asc
          plugin:
            kind: MetricLabelValues
            spec:
              labelName: k8s_cluster_name
              matchers:
              - gen_ai_client_operation_duration_seconds_count
              - ollama_api_up
              - vllm:generation_tokens_total
