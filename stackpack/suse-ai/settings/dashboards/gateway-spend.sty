# Generated by scripts/dashboards-icons/build_dashboards.py; edit that source.
nodes:
- _type: Dashboard
  identifier: urn:stackpack:suse-ai:shared:dashboard:gateway-spend
  name: SUSE AI — Gateway & spend
  description: Track LiteLLM gateway demand, failures, latency and reported spend by requested model.
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        about:
          spec:
            display:
              name: About / How to read
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '[Overview](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:overview) · [Model serving](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:model-serving)
                  · **Gateway & spend** · [GPU fleet](/#/dashboards/urn:stackpack:suse-ai:shared:dashboard:gpu-fleet)


                  Track LiteLLM gateway demand, failures, latency and reported spend by requested model. **How to read:**
                  All rates use five minutes. Spend / h extrapolates the reported five-minute cost rate; it is not a bill
                  or a prediction. LiteLLM prices are expressed in USD; verify configured model prices. Zero reported spend
                  does not establish that compute is free. New telemetry may have no hour-ago baseline.'
            queries: []
            links: []
        gateway-requests:
          spec:
            display:
              name: Gateway requests / min
              description: LiteLLM proxy requests, including failures.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: short
                  decimalPlaces: 1
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user,
                      hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code,
                      user_email, route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status,
                      le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        gateway-failed:
          spec:
            display:
              name: Gateway failed (%)
              description: Failure counter divided by all proxy requests. No traffic gives no percentage.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: percent
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 100 * (sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user,
                      hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code,
                      user_email, route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status,
                      le) (rate(litellm_proxy_failed_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m]))) or (0 *
                      sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
                      api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email,
                      route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))))
                      / (sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
                      api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email,
                      route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                      > 0)
                    alias: Now
            links: []
        gateway-latency:
          spec:
            display:
              name: Gateway duration p95
              description: P95 of reported end-to-end proxy durations; an idle histogram remains undefined.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: s
                  decimalPlaces: 2
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (le) (max by (k8s_cluster_name, service_namespace, service_name,
                      service_instance_id, end_user, hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias,
                      requested_model, model, status_code, user_email, route, client_ip, user_agent, model_id, api_provider,
                      exception_class, exception_status, le) (rate(litellm_request_total_latency_metric_bucket{k8s_cluster_name=~"${cluster}"}[5m]))))
                    alias: Now
            links: []
        gateway-spend:
          spec:
            display:
              name: Reported spend / h (USD)
              description: 3600 × the five-minute rate of LiteLLM reported spend. Counter resets are handled before aggregation.
            plugin:
              kind: StatChart
              spec:
                calculation: last
                format:
                  unit: currencyUSD
                  decimalPlaces: 4
                sparkline: true
                thresholds:
                  defaultColor: '#1F78B4'
                  steps: []
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 3600 * sum (max by (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user,
                      hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, status_code,
                      user_email, route, client_ip, user_agent, model_id, api_provider, exception_class, exception_status,
                      le) (rate(litellm_spend_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: Now
            links: []
        requests-compare:
          spec:
            display:
              name: Requests / min by outcome
              description: Compare model routes and status codes before examining the backend. Current selected time window;
                no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 60 * sum by (service_namespace, service_name, requested_model, status_code) (max by (k8s_cluster_name,
                      service_namespace, service_name, service_instance_id, end_user, hashed_api_key, api_key_alias, team,
                      team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email, route, client_ip,
                      user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_proxy_requests_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: ${service_namespace}/${service_name} · ${requested_model} · HTTP ${status_code}
            links: []
        latency-compare:
          spec:
            display:
              name: Gateway duration p95
              description: Measured total request latency by requested model. Current selected time window; no shifted historical
                series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: s
                    decimalPlaces: 2
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: histogram_quantile(0.95, sum by (service_namespace, service_name, requested_model, le) (max by
                      (k8s_cluster_name, service_namespace, service_name, service_instance_id, end_user, hashed_api_key, api_key_alias,
                      team, team_alias, user, org_id, org_alias, requested_model, model, status_code, user_email, route, client_ip,
                      user_agent, model_id, api_provider, exception_class, exception_status, le) (rate(litellm_request_total_latency_metric_bucket{k8s_cluster_name=~"${cluster}"}[5m]))))
                    alias: ${service_namespace}/${service_name} · ${requested_model}
            links: []
        spend-compare:
          spec:
            display:
              name: Reported spend / h (USD)
              description: Configured model prices determine reported spend; this does not include GPU infrastructure costs.
                Current selected time window; no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: currencyUSD
                    decimalPlaces: 4
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: 3600 * sum by (service_namespace, service_name, requested_model) (max by (k8s_cluster_name, service_namespace,
                      service_name, service_instance_id, end_user, hashed_api_key, api_key_alias, team, team_alias, user,
                      org_id, org_alias, requested_model, model, status_code, user_email, route, client_ip, user_agent, model_id,
                      api_provider, exception_class, exception_status, le) (rate(litellm_spend_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: ${service_namespace}/${service_name} · ${requested_model}
            links: []
        tokens-compare:
          spec:
            display:
              name: Gateway tokens / s
              description: LiteLLM token observations, separate from client and inference-server counters. Current selected
                time window; no shifted historical series.
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  min: 0
                  format:
                    unit: short
                    decimalPlaces: 1
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                visual:
                  connectNulls: false
            queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum by (service_namespace, service_name, requested_model) (max by (k8s_cluster_name, service_namespace,
                      service_name, service_instance_id, end_user, hashed_api_key, api_key_alias, team, team_alias, user,
                      org_id, org_alias, requested_model, model, status_code, user_email, route, client_ip, user_agent, model_id,
                      api_provider, exception_class, exception_status, le) (rate(litellm_tokens_metric_total{k8s_cluster_name=~"${cluster}"}[5m])))
                    alias: ${service_namespace}/${service_name} · ${requested_model}
            links: []
        coverage:
          spec:
            display:
              name: Coverage / Next steps
              description: ''
            plugin:
              kind: Markdown
              spec:
                text: '**Investigate:** high failure rates → inspect status codes and the routed model; high latency → compare
                  with Model serving. Rising reported spend → compare tokens and model pricing.


                  **Aggregation:** native request dimensions and serving replica identity survive scrape deduplication, then
                  totals are grouped by service and requested model. No per-user or API-key values appear in chart legends.
                  Missing data remains unknown; zero spend reflects only what LiteLLM reported.'
            queries: []
            links: []
      layouts:
      - kind: Grid
        spec:
          items:
          - x: 0
            y: 0
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/about'
          - x: 0
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-requests'
          - x: 6
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-failed'
          - x: 12
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-latency'
          - x: 18
            y: 1
            width: 6
            height: 2
            content:
              $ref: '#/spec/panels/gateway-spend'
          - x: 0
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/requests-compare'
          - x: 12
            y: 3
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/latency-compare'
          - x: 0
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/spend-compare'
          - x: 12
            y: 6
            width: 12
            height: 3
            content:
              $ref: '#/spec/panels/tokens-compare'
          - x: 0
            y: 9
            width: 24
            height: 1
            content:
              $ref: '#/spec/panels/coverage'
      variables:
      - kind: ListVariable
        spec:
          name: cluster
          display:
            name: Cluster
            description: Cluster reporting these metrics.
          allowMultiple: false
          allowAllValue: false
          sort: alphabetical-asc
          plugin:
            kind: MetricLabelValues
            spec:
              labelName: k8s_cluster_name
              matchers:
              - litellm_proxy_requests_metric_total
