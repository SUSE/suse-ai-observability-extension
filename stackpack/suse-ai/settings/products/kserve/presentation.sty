nodes:
- _type: ComponentPresentation
  name: Product Kserve
  identifier: urn:stackpack:suse-ai:component-presentation:product-kserve
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:kserve"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_kserve
        title: Kserve
        order: 200
        metrics:
        - metricId: suse_ai_kserve_request_rate
          order: 100
        - metricId: suse_ai_kserve_latency_p95
          order: 99
        - metricId: suse_ai_kserve_reconcile_error_ratio
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_kserve
        title: KServe
        order: 50
        sections:
        - sectionId: suse_ai_kserve_performance
          title: Performance
          order: 50
          metrics:
          - metricId: suse_ai_kserve_request_rate
            order: 100
          - metricId: suse_ai_kserve_latency_p95
            order: 99
        - sectionId: suse_ai_kserve_runtime
          title: Runtime
          order: 49
          metrics:
          - metricId: suse_ai_kserve_step_latency
            order: 98
        - sectionId: suse_ai_kserve_control_plane
          title: Control Plane
          order: 48
          metrics:
          - metricId: suse_ai_kserve_reconcile_rate
            order: 97
          - metricId: suse_ai_kserve_reconcile_error_ratio
            order: 96
          - metricId: suse_ai_kserve_workqueue_depth
            order: 95
  metrics:
  - metricId: suse_ai_kserve_request_rate
    name: Request Rate
    metricQueries:
    - expression: sum by (model_name) (rate(request_predict_seconds_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_kserve_latency_p95
    name: Predict Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by (le) (rate(request_predict_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by (le) (rate(request_predict_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.50, sum by (le) (rate(request_predict_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kserve_step_latency
    name: Per-Step Latency P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (le) (rate(request_preprocess_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: preprocess P95
    - expression: histogram_quantile(0.95, sum by (le) (rate(request_predict_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: predict P95
      primary: true
    - expression: histogram_quantile(0.95, sum by (le) (rate(request_postprocess_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: postprocess P95
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kserve_reconcile_rate
    name: Reconcile Rate
    metricQueries:
    - expression: sum by (controller) (rate(controller_runtime_reconcile_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${controller}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kserve_reconcile_error_ratio
    name: Reconcile Error Ratio
    metricQueries:
    - expression: (sum(rate(controller_runtime_reconcile_total{result="error", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
        or (0 * sum(rate(controller_runtime_reconcile_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))))
        / clamp_min(sum(rate(controller_runtime_reconcile_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])),
        1e-9)
      alias: error ratio
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_kserve_workqueue_depth
    name: Workqueue Depth
    metricQueries:
    - expression: max by (name) (workqueue_depth{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
