# Deduplicate scrape copies within each native LiteLLM series and real replica,
# then aggregate replicas. Native user/model labels must survive the inner max.
nodes:
- _type: ComponentPresentation
  name: LiteLLM product
  identifier: urn:stackpack:suse-ai:component-presentation:product-litellm
  binding:
    _type: ComponentPresentationQueryBinding
    query: label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label = "stackpack:suse-ai"
      and label = "suse.ai.product:litellm"
  rank:
    specificity: 240
  presentation:
    icon: !icon products/litellm.svg
    highlight:
      fields:
      - fieldId: suse_ai_product
        title: Product
        order: 45
        projection:
          _type: TextProjection
          value: '''litellm'''
      metrics:
      - sectionId: suse-ai-product-litellm
        title: LiteLLM
        order: 200
        metrics:
        - metricId: suse-ai-litellm-request-rate
          order: 100
        - metricId: suse-ai-litellm-latency-p95
          order: 99
        - metricId: suse-ai-litellm-in-flight
          order: 98
    summary:
      metrics:
      - summaryMetricId: suse-ai-litellm-request-rate-summary
        metricId: suse-ai-litellm-request-rate
        name: Proxy request rate
        order: 100
        unit: reqps
        decimalPlaces: 2
        query: sum by (requested_model) (max by (service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
          api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, status_code, user_email, route, client_ip,
          user_agent, model_id, api_provider, stream) (rate({__name__=~"litellm_proxy_(total_)?requests_metric(_total)?",
          __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      - summaryMetricId: suse-ai-litellm-latency-p95-summary
        metricId: suse-ai-litellm-latency-p95
        name: Request latency P95
        order: 99
        unit: s
        decimalPlaces: 2
        query: histogram_quantile(0.95, sum by (requested_model, le) (max by (service_namespace, service_name, service_instance_id,
          end_user, hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, model_id,
          api_provider, service_tier, le) (rate({__name__=~"litellm_request_total_latency_metric_bucket", __multi__="${selectPrefix(tags,
          'suse.ai.metric.')}"}[${__rate_interval}]))))
    metricPerspective:
      tabs:
      - tabId: suse-ai-litellm
        title: LiteLLM
        order: 50
        sections:
        - sectionId: suse-ai-litellm-traffic
          title: Traffic and latency
          order: 100
          metrics:
          - metricId: suse-ai-litellm-request-rate
            order: 100
          - metricId: suse-ai-litellm-latency-p95
            order: 99
          - metricId: suse-ai-litellm-in-flight
            order: 98
          - metricId: suse-ai-litellm-failures
            order: 97
        - sectionId: suse-ai-litellm-models
          title: Models
          order: 90
          metrics:
          - metricId: suse-ai-litellm-input-tokens
            order: 100
          - metricId: suse-ai-litellm-output-tokens
            order: 99
          - metricId: suse-ai-litellm-backend-state
            order: 98
        - sectionId: suse-ai-litellm-guardrails
          title: Guardrails
          order: 80
          metrics:
          - metricId: suse-ai-litellm-guardrail-requests
            order: 100
          - metricId: suse-ai-litellm-guardrail-errors
            order: 99
          - metricId: suse-ai-litellm-guardrail-latency
            order: 98
  metrics:
  - metricId: suse-ai-litellm-request-rate
    name: Proxy request rate
    metricQueries:
    - expression: sum by (requested_model) (max by (service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
        api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, status_code, user_email, route, client_ip,
        user_agent, model_id, api_provider, stream) (rate({__name__=~"litellm_proxy_(total_)?requests_metric(_total)?", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: ${requested_model}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse-ai-litellm-latency-p95
    name: Request latency P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (requested_model, le) (max by (service_namespace, service_name, service_instance_id,
        end_user, hashed_api_key, api_key_alias, team, team_alias, user, org_id, org_alias, requested_model, model, model_id,
        api_provider, service_tier, le) (rate({__name__=~"litellm_request_total_latency_metric_bucket", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))))
      alias: ${requested_model}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse-ai-litellm-input-tokens
    name: Input token rate
    metricQueries:
    - expression: sum by (requested_model) (max by (service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
        api_key_alias, team, team_alias, user, org_id, org_alias, user_email, requested_model, model, model_id, api_provider)
        (rate({__name__=~"litellm_input_tokens_metric(_total)?", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: ${requested_model}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-output-tokens
    name: Output token rate
    metricQueries:
    - expression: sum by (requested_model) (max by (service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
        api_key_alias, team, team_alias, user, org_id, org_alias, user_email, requested_model, model, model_id, api_provider)
        (rate({__name__=~"litellm_output_tokens_metric(_total)?", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: ${requested_model}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-in-flight
    name: In-flight requests
    metricQueries:
    - expression: sum by (model) (max by (service_namespace, service_name, service_instance_id, model) ({__name__=~"litellm_in_flight_requests",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}))
      alias: Requests
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-failures
    name: LLM failures, including guardrail blocks (5m)
    metricQueries:
    - expression: sum by (model) (max by (service_namespace, service_name, service_instance_id, end_user, hashed_api_key,
        api_key_alias, team, team_alias, user, org_id, org_alias, model, model_id) (increase({__name__=~"litellm_llm_api_failed_requests_metric(_total)?",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
      alias: ${model}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-backend-state
    name: 'Backend state: 0 healthy, 1 partial outage, 2 outage'
    metricQueries:
    - expression: max by (litellm_model_name, api_base) (max by (service_namespace, service_name, service_instance_id, litellm_model_name,
        model_id, api_base, api_provider) ({__name__=~"litellm_deployment_state", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}))
      alias: ${litellm_model_name} / ${api_base}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-guardrail-requests
    name: Guardrail invocations (5m)
    metricQueries:
    - expression: sum by (guardrail_name, status) (max by (service_namespace, service_name, service_instance_id, guardrail_name,
        status, hook_type) (increase({__name__=~"litellm_guardrail_requests(_total)?", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
      alias: '${guardrail_name}: ${status}'
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-guardrail-errors
    name: Guardrail errors (5m)
    metricQueries:
    - expression: sum by (guardrail_name, error_type) (max by (service_namespace, service_name, service_instance_id, guardrail_name,
        error_type, hook_type) (increase({__name__=~"litellm_guardrail_errors(_total)?", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
      alias: '${guardrail_name}: ${error_type}'
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-litellm-guardrail-latency
    name: Guardrail latency P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (guardrail_name, le) (max by (service_namespace, service_name, service_instance_id,
        guardrail_name, status, hook_type, error_type, le) (rate({__name__=~"litellm_guardrail_latency_seconds_bucket", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))))
      alias: ${guardrail_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
