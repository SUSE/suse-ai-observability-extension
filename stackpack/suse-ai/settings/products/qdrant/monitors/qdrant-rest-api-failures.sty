nodes:
- _type: Monitor
  name: Qdrant REST API Failures
  identifier: urn:stackpack:suse-ai:monitor:qdrant-rest-api-failures
  description: Indicates if Qdrant is returning failed REST API responses.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.0
    comparator: GT
    failureState: CRITICAL
    metric:
      aliasTemplate: Qdrant REST API Failures
      query: |-
        sum by (service_namespace, service_name) (rate(rest_responses_total{suse_ai_product="qdrant", service_namespace!="", service_name!="", status=~"[45][0-9][0-9]"}[5m]))
        or (0 * sum by (service_namespace, service_name) (rate(rest_responses_total{suse_ai_product="qdrant", service_namespace!="", service_name!="", status=~"[1-5][0-9][0-9]"}[5m])))
      unit: reqps
    titleTemplate: Qdrant REST API Failures
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/qdrant/remediation-rest-failures.md.hbs'
