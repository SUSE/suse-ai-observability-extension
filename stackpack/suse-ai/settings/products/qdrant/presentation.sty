nodes:
- _type: ComponentPresentation
  name: Product Qdrant
  identifier: urn:stackpack:suse-ai:component-presentation:product-qdrant
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:qdrant"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_qdrant
        title: Qdrant
        order: 200
        metrics:
        - metricId: suse_ai_qdrant_vectordb_collections_total
          order: 100
        - metricId: suse_ai_qdrant_vectordb_vectors_total
          order: 99
        - metricId: suse_ai_qdrant_vectordb_rest_responses_total
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_vectordb
        title: VectorDB
        order: 50
        sections:
        - sectionId: suse_ai_vectordb_collections
          title: Collections
          order: 50
          metrics:
          - metricId: suse_ai_qdrant_vectordb_collections_total
            order: 100
          - metricId: suse_ai_qdrant_vectordb_vectors_total
            order: 99
        - sectionId: suse_ai_vectordb_rest_api
          title: REST API
          order: 49
          metrics:
          - metricId: suse_ai_qdrant_vectordb_rest_responses_total
            order: 98
          - metricId: suse_ai_qdrant_vectordb_rest_responses_fail
            order: 97
          - metricId: suse_ai_qdrant_vectordb_rest_responses_avg_duration
            order: 96
        - sectionId: suse_ai_vectordb_grpc_api
          title: gRPC API
          order: 48
          metrics:
          - metricId: suse_ai_qdrant_vectordb_grpc_responses_total
            order: 95
          - metricId: suse_ai_qdrant_vectordb_grpc_responses_fail
            order: 94
          - metricId: suse_ai_qdrant_vectordb_grpc_responses_avg_duration
            order: 93
        - sectionId: suse_ai_vectordb_hardware
          title: Hardware
          order: 47
          metrics:
          - metricId: suse_ai_qdrant_vectordb_memory_active
            order: 91
  metrics:
  - metricId: suse_ai_qdrant_vectordb_collections_total
    name: Collections Total
    metricQueries:
    - expression: collections_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Collections
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_qdrant_vectordb_vectors_total
    name: Vectors Total
    metricQueries:
    - expression: collections_vector_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Vectors
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_qdrant_vectordb_rest_responses_total
    name: REST Responses Rate
    metricQueries:
    - expression: sum(rate(rest_responses_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Responses/s
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_qdrant_vectordb_rest_responses_fail
    name: REST Responses Failure Rate
    metricQueries:
    - expression: sum(rate(rest_responses_total{status=~"[45][0-9][0-9]", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
        or (0 * sum(rate(rest_responses_total{status=~"[1-5][0-9][0-9]", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: Failures/s
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_qdrant_vectordb_rest_responses_avg_duration
    name: REST Average Response Duration
    metricQueries:
    - expression: rest_responses_avg_duration_seconds{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Avg Duration
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_qdrant_vectordb_grpc_responses_total
    name: gRPC Responses Rate
    metricQueries:
    - expression: sum(rate(grpc_responses_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Responses/s
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_qdrant_vectordb_grpc_responses_fail
    name: gRPC Responses Failure Rate
    metricQueries:
    - expression: sum(rate(grpc_responses_total{status=~"[1-9][0-9]*", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
        or (0 * sum(rate(grpc_responses_total{status=~"[0-9]+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: Failures/s
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_qdrant_vectordb_grpc_responses_avg_duration
    name: gRPC Average Response Duration
    metricQueries:
    - expression: grpc_responses_avg_duration_seconds{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Avg Duration
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_qdrant_vectordb_memory_active
    name: Memory Active
    metricQueries:
    - expression: memory_active_bytes{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Active Memory
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: bytes
