nodes:
- _type: ComponentPresentation
  name: Served Models Vllm
  identifier: urn:stackpack:suse-ai:component-presentation:served-models-vllm
  binding:
    _type: ComponentPresentationQueryBinding
    query: (type = "genai served model" and label = "suse.ai.product:vllm" and label = "stackpack:suse-ai")
  rank:
    specificity: 240
  presentation:
    overview:
      name:
        singular: vLLM model
        plural: vLLM models
        title: vLLM models
      columns:
      - columnId: suse_ai_health
        title: Health
        projection:
          _type: HealthProjection
          value: healthState
      - columnId: suse_ai_model_latency
        title: Request latency P95
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: s
          query: histogram_quantile(0.95, sum by(service_namespace, service_name, model_name, le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
            service_namespace="${tags.singleValue('service.namespace')}", service_name="${tags.singleValue('service.name')}",
            model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
          metricId: suse_ai_genai_model_e2e_latency
      - columnId: suse_ai_model_ttft
        title: Time to first token P95
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: s
          query: histogram_quantile(0.95, sum by(service_namespace, service_name, model_name, le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
            service_namespace="${tags.singleValue('service.namespace')}", service_name="${tags.singleValue('service.name')}",
            model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
          metricId: suse_ai_genai_model_ttft_latency
      - columnId: suse_ai_model_output_tokens
        title: Output tokens / s
        projection:
          _type: MetricProjection
          sparkline: true
          decimalPlaces: 2
          unit: short
          query: sum by(service_namespace, service_name, model_name) (rate({__name__=~"vllm(:|_)generation_tokens_total",
            service_namespace="${tags.singleValue('service.namespace')}", service_name="${tags.singleValue('service.name')}",
            model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
          metricId: suse_ai_genai_model_token_throughput_generation
      sort: []
    highlight:
      metrics:
      - sectionId: suse_ai_served_models_vllm
        title: vLLM
        order: 200
        metrics:
        - metricId: suse_ai_genai_model_e2e_latency
          order: 100
        - metricId: suse_ai_genai_model_ttft_latency
          order: 99
        - metricId: suse_ai_genai_model_tpot_latency
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_performance
        title: Performance
        order: 50
        sections:
        - sectionId: suse_ai_performance_latency
          title: Latency
          order: 50
          metrics:
          - metricId: suse_ai_genai_model_e2e_latency
            order: 100
          - metricId: suse_ai_genai_model_ttft_latency
            order: 99
          - metricId: suse_ai_genai_model_tpot_latency
            order: 98
        - sectionId: suse_ai_performance_throughput
          title: Throughput
          order: 49
          metrics:
          - metricId: suse_ai_genai_model_token_throughput_prompt
            order: 97
          - metricId: suse_ai_genai_model_token_throughput_generation
            order: 96
        - sectionId: suse_ai_performance_cache_utilization
          title: Cache Utilization
          order: 48
          metrics:
          - metricId: suse_ai_genai_model_gpu_cache_usage
            order: 95
        - sectionId: suse_ai_performance_scheduler
          title: Scheduler
          order: 47
          metrics:
          - metricId: suse_ai_genai_model_req_running
            order: 94
          - metricId: suse_ai_genai_model_req_waiting
            order: 93
    summary:
      metrics:
      - summaryMetricId: suse_ai_genai_model_e2e_latency_summary
        name: End-to-End Request Latency
        metricId: suse_ai_genai_model_e2e_latency
        order: 100
        unit: s
        decimalPlaces: 2
        query: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
          __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      - summaryMetricId: suse_ai_genai_model_ttft_latency_summary
        name: Time To First Token Latency
        metricId: suse_ai_genai_model_ttft_latency
        order: 99
        unit: s
        decimalPlaces: 2
        query: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
          __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      - summaryMetricId: suse_ai_genai_model_tpot_latency_summary
        name: Time Per Output Token Latency
        metricId: suse_ai_genai_model_tpot_latency
        order: 98
        unit: s
        decimalPlaces: 2
        query: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
          __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      - summaryMetricId: suse_ai_genai_model_token_throughput_prompt_summary
        name: Token Throughput (Prompt)
        metricId: suse_ai_genai_model_token_throughput_prompt
        order: 97
        unit: short
        decimalPlaces: 2
        query: sum(rate({__name__=~"vllm(:|_)prompt_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}",
          model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
  metrics:
  - metricId: suse_ai_genai_model_e2e_latency
    name: End-to-End Request Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_sum", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])) / sum(rate({__name__=~"vllm(:|_)e2e_request_latency_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
      alias: Average
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_genai_model_ttft_latency
    name: Time To First Token Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm(:|_)time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm(:|_)time_to_first_token_seconds_sum", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])) / sum(rate({__name__=~"vllm(:|_)time_to_first_token_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
      alias: Average
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_genai_model_tpot_latency
    name: Time Per Output Token Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_sum", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}])) / sum(rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
      alias: Average
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_genai_model_token_throughput_prompt
    name: Token Throughput (Prompt)
    metricQueries:
    - expression: sum(rate({__name__=~"vllm(:|_)prompt_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}",
        model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
      alias: Prompt Tokens/Sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_genai_model_token_throughput_generation
    name: Token Throughput (Generation)
    metricQueries:
    - expression: sum(rate({__name__=~"vllm(:|_)generation_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}",
        model_name="${tags.singleValue('vllm.model.name')}"}[${__rate_interval}]))
      alias: Generation Tokens/Sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_genai_model_gpu_cache_usage
    name: GPU Cache Usage
    metricQueries:
    - expression: max(vllm_gpu_cache_usage_perc{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}
        or {__name__=~"vllm(:|_)(gpu|kv)_cache_usage_perc", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}",
        model_name="${tags.singleValue('vllm.model.name')}"})
      alias: GPU Cache Usage
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_genai_model_req_running
    name: Number of Requests Running
    metricQueries:
    - expression: sum(vllm_num_requests_running{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}
        or vllm:num_requests_running{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"})
      alias: req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_genai_model_req_waiting
    name: Number of Requests Waiting
    metricQueries:
    - expression: sum(vllm_num_requests_waiting{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"}
        or vllm:num_requests_waiting{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}", model_name="${tags.singleValue('vllm.model.name')}"})
      alias: req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
