nodes:
- _type: ComponentPresentation
  name: Product Vllm
  identifier: urn:stackpack:suse-ai:component-presentation:product-vllm
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label = "stackpack:suse-ai")
      and label = "suse.ai.product:vllm"
  rank:
    specificity: 240
  presentation:
    highlight:
      metrics:
      - sectionId: suse-ai-product-vllm
        title: vLLM
        order: 200
        metrics:
        - metricId: suse-ai-vllm-request-rate
          order: 101
        - metricId: suse-ai-vllm-e2e-latency
          order: 100
        - metricId: suse-ai-vllm-ttft-latency
          order: 99
        - metricId: suse-ai-vllm-tpot-latency
          order: 98
    icon: !icon products/vllm.svg
    metricPerspective:
      tabs:
      - tabId: suse-ai-performance
        title: Performance
        order: 50
        sections:
        - sectionId: suse-ai-performance-latency
          title: Latency
          order: 50
          metrics:
          - metricId: suse-ai-vllm-e2e-latency
            order: 100
          - metricId: suse-ai-vllm-ttft-latency
            order: 99
          - metricId: suse-ai-vllm-tpot-latency
            order: 98
        - sectionId: suse-ai-performance-models
          title: Models
          order: 49
          metrics:
          - metricId: suse-ai-vllm-top-models-by-usage
            order: 97
        - sectionId: suse-ai-performance-throughput
          title: Throughput
          order: 48
          metrics:
          - metricId: suse-ai-vllm-request-rate
            order: 100
          - metricId: suse-ai-vllm-token-throughput-prompt
            order: 96
          - metricId: suse-ai-vllm-token-throughput-generation
            order: 95
        - sectionId: suse-ai-performance-cache-utilization
          title: Cache Utilization
          order: 47
          metrics:
          - metricId: suse-ai-vllm-gpu-cache-usage
            order: 94
        - sectionId: suse-ai-performance-scheduler
          title: Scheduler
          order: 46
          metrics:
          - metricId: suse-ai-vllm-req-running
            order: 93
          - metricId: suse-ai-vllm-req-waiting
            order: 92
    summary:
      metrics:
      - summaryMetricId: suse-ai-vllm-request-rate-summary
        name: Successful request rate
        metricId: suse-ai-vllm-request-rate
        order: 101
        unit: reqps
        decimalPlaces: 2
        query: |-
          sum by (model_name) (rate({__name__=~"vllm:request_success_total|vllm_request_success_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      - summaryMetricId: suse-ai-vllm-e2e-latency-summary
        name: End-to-End Request Latency
        metricId: suse-ai-vllm-e2e-latency
        order: 100
        unit: s
        decimalPlaces: 2
        query: |-
          histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      - summaryMetricId: suse-ai-vllm-ttft-latency-summary
        name: Time To First Token Latency
        metricId: suse-ai-vllm-ttft-latency
        order: 99
        unit: s
        decimalPlaces: 2
        query: |-
          histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      - summaryMetricId: suse-ai-vllm-tpot-latency-summary
        name: Time Per Output Token Latency
        metricId: suse-ai-vllm-tpot-latency
        order: 98
        unit: s
        decimalPlaces: 2
        query: |-
          histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:time_per_output_token_seconds_bucket|vllm_time_per_output_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      - summaryMetricId: suse-ai-vllm-top-models-by-usage-summary
        name: Top models by token throughput
        metricId: suse-ai-vllm-top-models-by-usage
        order: 97
        unit: short
        decimalPlaces: 2
        query: |-
          topk(5, sum by (model_name) (rate({__name__=~"vllm:prompt_tokens_total|vllm_prompt_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m]) + rate({__name__=~"vllm:generation_tokens_total|vllm_generation_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
  metrics:
  - metricId: suse-ai-vllm-request-rate
    name: Successful request rate
    metricQueries:
    - expression: |-
        sum by (model_name) (rate({__name__=~"vllm:request_success_total|vllm_request_success_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse-ai-vllm-e2e-latency
    name: End-to-End Request Latency
    metricQueries:
    - expression: |-
        histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: |-
        histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: |-
        histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: |-
        histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: |-
        sum(rate({__name__=~"vllm:e2e_request_latency_seconds_sum|vllm_e2e_request_latency_seconds_sum", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm:e2e_request_latency_seconds_count|vllm_e2e_request_latency_seconds_count", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse-ai-vllm-ttft-latency
    name: Time To First Token Latency
    metricQueries:
    - expression: |-
        histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: |-
        histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: |-
        histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: |-
        histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: |-
        sum(rate({__name__=~"vllm:time_to_first_token_seconds_sum|vllm_time_to_first_token_seconds_sum", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm:time_to_first_token_seconds_count|vllm_time_to_first_token_seconds_count", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse-ai-vllm-tpot-latency
    name: Time Per Output Token Latency
    metricQueries:
    - expression: |-
        histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:time_per_output_token_seconds_bucket|vllm_time_per_output_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: |-
        histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm:time_per_output_token_seconds_bucket|vllm_time_per_output_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: |-
        histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm:time_per_output_token_seconds_bucket|vllm_time_per_output_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: |-
        histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm:time_per_output_token_seconds_bucket|vllm_time_per_output_token_seconds_bucket", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: |-
        sum(rate({__name__=~"vllm:time_per_output_token_seconds_sum|vllm_time_per_output_token_seconds_sum", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm:time_per_output_token_seconds_count|vllm_time_per_output_token_seconds_count", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse-ai-vllm-top-models-by-usage
    name: Top models by token throughput
    metricQueries:
    - expression: |-
        topk(5, sum by (model_name) (rate({__name__=~"vllm:prompt_tokens_total|vllm_prompt_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m]) + rate({__name__=~"vllm:generation_tokens_total|vllm_generation_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-vllm-token-throughput-prompt
    name: Token Throughput (Prompt)
    metricQueries:
    - expression: |-
        sum by (model_name)(rate({__name__=~"vllm:prompt_tokens_total|vllm_prompt_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name} tokens/sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-vllm-token-throughput-generation
    name: Token Throughput (Generation)
    metricQueries:
    - expression: |-
        sum by (model_name)(rate({__name__=~"vllm:generation_tokens_total|vllm_generation_tokens_total", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name} tokens/sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-vllm-gpu-cache-usage
    name: GPU Cache Usage
    metricQueries:
    - expression: |-
        max by (model_name)(vllm_gpu_cache_usage_perc{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"} or vllm:gpu_cache_usage_perc{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse-ai-vllm-req-running
    name: Number of Requests Running
    metricQueries:
    - expression: |-
        sum by (model_name)(vllm_num_requests_running{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"} or vllm:num_requests_running{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name} req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse-ai-vllm-req-waiting
    name: Number of Requests Waiting
    metricQueries:
    - expression: |-
        sum by (model_name)(vllm_num_requests_waiting{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"} or vllm:num_requests_waiting{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name} req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
