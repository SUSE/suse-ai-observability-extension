nodes:
- _type: ComponentPresentation
  name: Product Vllm
  identifier: urn:stackpack:suse-ai:component-presentation:product-vllm
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:vllm"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_vllm
        title: vLLM
        order: 200
        metrics:
        - metricId: suse_ai_vllm_request_rate
          order: 101
        - metricId: suse_ai_vllm_e2e_latency
          order: 100
        - metricId: suse_ai_vllm_ttft_latency
          order: 99
        - metricId: suse_ai_vllm_tpot_latency
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_performance
        title: Performance
        order: 50
        sections:
        - sectionId: suse_ai_performance_latency
          title: Latency
          order: 50
          metrics:
          - metricId: suse_ai_vllm_e2e_latency
            order: 100
          - metricId: suse_ai_vllm_ttft_latency
            order: 99
          - metricId: suse_ai_vllm_tpot_latency
            order: 98
        - sectionId: suse_ai_performance_models
          title: Models
          order: 49
          metrics:
          - metricId: suse_ai_vllm_top_models_by_usage
            order: 97
        - sectionId: suse_ai_performance_throughput
          title: Throughput
          order: 48
          metrics:
          - metricId: suse_ai_vllm_request_rate
            order: 100
          - metricId: suse_ai_vllm_token_throughput_prompt
            order: 96
          - metricId: suse_ai_vllm_token_throughput_generation
            order: 95
        - sectionId: suse_ai_performance_cache_utilization
          title: Cache Utilization
          order: 47
          metrics:
          - metricId: suse_ai_vllm_gpu_cache_usage
            order: 94
        - sectionId: suse_ai_performance_scheduler
          title: Scheduler
          order: 46
          metrics:
          - metricId: suse_ai_vllm_req_running
            order: 93
          - metricId: suse_ai_vllm_req_waiting
            order: 92
  metrics:
  - metricId: suse_ai_vllm_request_rate
    name: Finished request rate
    metricQueries:
    - expression: sum by (model_name) (rate({__name__=~"vllm:request_success_total|vllm_request_success_total",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_vllm_e2e_latency
    name: End-to-End Request Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm:e2e_request_latency_seconds_bucket|vllm_e2e_request_latency_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm:e2e_request_latency_seconds_sum|vllm_e2e_request_latency_seconds_sum",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm:e2e_request_latency_seconds_count|vllm_e2e_request_latency_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_vllm_ttft_latency
    name: Time To First Token Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm:time_to_first_token_seconds_bucket|vllm_time_to_first_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm:time_to_first_token_seconds_sum|vllm_time_to_first_token_seconds_sum",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm:time_to_first_token_seconds_count|vllm_time_to_first_token_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_vllm_tpot_latency
    name: Time Per Output Token Latency
    metricQueries:
    - expression: histogram_quantile(0.99, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P99
    - expression: histogram_quantile(0.95, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    - expression: histogram_quantile(0.90, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P90
    - expression: histogram_quantile(0.50, sum by(le) (rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_bucket",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P50
    - expression: sum(rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_sum",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))/sum(rate({__name__=~"vllm(:|_)(request_)?time_per_output_token_seconds_count",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Avg
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_vllm_top_models_by_usage
    name: Top models by token throughput
    metricQueries:
    - expression: topk(5, sum by (model_name) (rate({__name__=~"vllm:prompt_tokens_total|vllm_prompt_tokens_total",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m]) + rate({__name__=~"vllm:generation_tokens_total|vllm_generation_tokens_total",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[5m])))
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_vllm_token_throughput_prompt
    name: Token Throughput (Prompt)
    metricQueries:
    - expression: sum by (model_name)(rate({__name__=~"vllm:prompt_tokens_total|vllm_prompt_tokens_total", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name} tokens/sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_vllm_token_throughput_generation
    name: Token Throughput (Generation)
    metricQueries:
    - expression: sum by (model_name)(rate({__name__=~"vllm:generation_tokens_total|vllm_generation_tokens_total",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${model_name} tokens/sec
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_vllm_gpu_cache_usage
    name: GPU Cache Usage
    metricQueries:
    - expression: max by (model_name)(vllm_gpu_cache_usage_perc{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
        or {__name__=~"vllm(:|_)(gpu|kv)_cache_usage_perc", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_vllm_req_running
    name: Number of Requests Running
    metricQueries:
    - expression: sum by (model_name)(vllm_num_requests_running{model_name=~".+", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"} or vllm:num_requests_running{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name} req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_vllm_req_waiting
    name: Number of Requests Waiting
    metricQueries:
    - expression: sum by (model_name)(vllm_num_requests_waiting{model_name=~".+", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"} or vllm:num_requests_waiting{model_name=~".+", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${model_name} req
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
