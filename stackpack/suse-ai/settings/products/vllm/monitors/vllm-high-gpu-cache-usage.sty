nodes:
- _type: Monitor
  name: 'Inference server service: KV cache is nearly full'
  identifier: urn:stackpack:suse-ai:monitor:vllm-high-gpu-cache-usage
  description: Indicates if vLLM GPU cache usage is approaching capacity.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.9
    comparator: GT
    failureState: CRITICAL
    metric:
      aliasTemplate: vLLM High GPU Cache Usage
      query: max by (service_namespace, service_name) (vllm_gpu_cache_usage_perc{suse_ai_product="vllm", service_namespace!="",
        service_name!=""} or {__name__=~"vllm(:|_)(gpu|kv)_cache_usage_perc", suse_ai_product="vllm", service_namespace!="",
        service_name!=""})
      unit: percentunit
    titleTemplate: 'Inference server ${service_name}: KV cache is nearly full'
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/vllm/remediation-gpu-cache.md.hbs'
