nodes:
- _type: ComponentPresentation
  name: Product Kubeflow Pipelines
  identifier: urn:stackpack:suse-ai:component-presentation:product-kubeflow-pipelines
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:kubeflow-pipelines"
  rank:
    specificity: 1
  presentation:
    metricPerspective:
      tabs:
      - tabId: suse_ai_kubeflow_pipelines
        title: Kubeflow Pipelines
        order: 50
        sections:
        - sectionId: suse_ai_kubeflow_pipelines_pipeline_runs
          title: Pipeline Runs
          order: 50
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_run_api_rate
            order: 100
          - metricId: suse_ai_kubeflow_pipelines_total_runs
            order: 98
          - metricId: suse_ai_kubeflow_pipelines_run_success_rate
            order: 96
          - metricId: suse_ai_kubeflow_pipelines_run_outcomes
            order: 95
        - sectionId: suse_ai_kubeflow_pipelines_control_plane
          title: Control Plane
          order: 49
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_pipeline_api_rate
            order: 99
          - metricId: suse_ai_kubeflow_pipelines_object_inventory
            order: 97
        - sectionId: suse_ai_kubeflow_pipelines_workflow_runtime
          title: Workflow Runtime
          order: 48
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_workflows_by_phase
            order: 94
          - metricId: suse_ai_kubeflow_pipelines_reconcile_latency_p95
            order: 90
          - metricId: suse_ai_kubeflow_pipelines_pending_pods
            order: 87
          - metricId: suse_ai_kubeflow_pipelines_pods_by_phase
            order: 86
          - metricId: suse_ai_kubeflow_pipelines_controller_error_rate
            order: 85
        - sectionId: suse_ai_kubeflow_pipelines_api_reliability
          title: API Reliability
          order: 47
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_grpc_request_rate
            order: 93
          - metricId: suse_ai_kubeflow_pipelines_grpc_error_ratio
            order: 92
          - metricId: suse_ai_kubeflow_pipelines_grpc_latency_p95
            order: 91
        - sectionId: suse_ai_kubeflow_pipelines_controller_queue
          title: Controller Queue
          order: 46
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_queue_work
            order: 89
          - metricId: suse_ai_kubeflow_pipelines_oldest_queue_item
            order: 88
          - metricId: suse_ai_kubeflow_pipelines_queue_retry_rate
            order: 84
        - sectionId: suse_ai_kubeflow_pipelines_demo_lifecycle
          title: Demo Lifecycle
          order: 45
          metrics:
          - metricId: suse_ai_kubeflow_pipelines_demo_step_duration_p95
            order: 83
          - metricId: suse_ai_kubeflow_pipelines_demo_model_accuracy
            order: 82
          - metricId: suse_ai_kubeflow_pipelines_demo_smoke_tests
            order: 81
  metrics:
  - metricId: suse_ai_kubeflow_pipelines_run_api_rate
    name: Run API Request Rate
    metricQueries:
    - expression: rate(run_server_create_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: create
    - expression: rate(run_server_get_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: get
      primary: true
    - expression: rate(run_server_list_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: list
    - expression: rate(run_server_terminate_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: terminate
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_kubeflow_pipelines_pipeline_api_rate
    name: Pipeline API Request Rate
    metricQueries:
    - expression: rate(pipeline_server_create_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: create
    - expression: rate(pipeline_server_list_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: list
      primary: true
    - expression: rate(pipeline_server_get_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: get
    - expression: rate(pipeline_upload_requests_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])
      alias: upload
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_kubeflow_pipelines_total_runs
    name: Total Pipeline Runs
    metricQueries:
    - expression: run_server_run_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: runs
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_object_inventory
    name: Object Inventory
    metricQueries:
    - expression: pipeline_server_pipeline_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: pipelines
      primary: true
    - expression: pipeline_server_pipeline_version_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: versions
    - expression: job_server_job_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: recurring jobs
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_run_success_rate
    name: Pipeline Run Success Rate
    metricQueries:
    - expression: (sum(resource_manager_workflow_runs_success{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
        or (0 * sum(resource_manager_workflow_runs_failed{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})))
        / (sum({__name__=~"resource_manager_workflow_runs_(success|failed)", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
        > 0)
      alias: success rate
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_kubeflow_pipelines_run_outcomes
    name: Pipeline Run Outcomes
    metricQueries:
    - expression: sum(resource_manager_workflow_runs_success{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
        or (0 * sum(resource_manager_workflow_runs_failed{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}))
      alias: succeeded
      primary: true
    - expression: sum(resource_manager_workflow_runs_failed{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
        or (0 * sum(resource_manager_workflow_runs_success{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}))
      alias: failed
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_workflows_by_phase
    name: Workflows by Phase
    metricQueries:
    - expression: sum by (phase) (argo_workflows_gauge{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${phase}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_grpc_request_rate
    name: gRPC Request Rate
    metricQueries:
    - expression: sum by (grpc_method) (rate(grpc_server_handled_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${grpc_method}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_kubeflow_pipelines_grpc_error_ratio
    name: gRPC Error Ratio
    metricQueries:
    - expression: (sum(rate(grpc_server_handled_total{grpc_code!="OK", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
        or (0 * sum(rate(grpc_server_handled_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))))
        / clamp_min(sum(rate(grpc_server_handled_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])),
        0.001)
      alias: error ratio
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_kubeflow_pipelines_grpc_latency_p95
    name: gRPC Handling Latency P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (le, grpc_method) (rate(grpc_server_handling_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: ${grpc_method}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kubeflow_pipelines_reconcile_latency_p95
    name: Workflow Reconcile Latency P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (le) (rate(argo_workflows_operation_duration_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: P95
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kubeflow_pipelines_queue_work
    name: Workflow Queue Work
    metricQueries:
    - expression: max by (queue_name) (argo_workflows_queue_depth_gauge{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${queue_name} depth
      primary: true
    - expression: max by (queue_name) (argo_workflows_queue_unfinished_work{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${queue_name} unfinished
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_oldest_queue_item
    name: Oldest Queue Item
    metricQueries:
    - expression: max by (queue_name) (argo_workflows_queue_longest_running{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${queue_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kubeflow_pipelines_pending_pods
    name: Pending Workflow Pods
    metricQueries:
    - expression: sum(argo_workflows_pods_gauge{phase="Pending", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: Pending
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_pods_by_phase
    name: Workflow Pods by Phase
    metricQueries:
    - expression: sum by (phase) (argo_workflows_pods_gauge{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: ${phase}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_kubeflow_pipelines_controller_error_rate
    name: Workflow Controller Error Rate
    metricQueries:
    - expression: sum by (cause) (rate(argo_workflows_error_count_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${cause}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: cps
  - metricId: suse_ai_kubeflow_pipelines_queue_retry_rate
    name: Workflow Queue Retry Rate
    metricQueries:
    - expression: sum by (queue_name) (rate(argo_workflows_queue_retries_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${queue_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: cps
  - metricId: suse_ai_kubeflow_pipelines_demo_step_duration_p95
    name: Demo Step Duration P95
    metricQueries:
    - expression: histogram_quantile(0.95, sum by (le, step) (last_over_time(suse_ai_kubeflow_pipeline_step_duration_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[24h]) and topk(1, tlast_over_time(suse_ai_kubeflow_pipeline_step_duration_seconds_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[24h])) by (le, step)))
      alias: ${step}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_kubeflow_pipelines_demo_model_accuracy
    name: Demo Model Accuracy
    metricQueries:
    - expression: (sum(last_over_time(suse_ai_kubeflow_model_accuracy_sum{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[24h])
        and topk(1, tlast_over_time(suse_ai_kubeflow_model_accuracy_sum{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[24h])))
        / clamp_min(sum(last_over_time(suse_ai_kubeflow_model_accuracy_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[24h])
        and topk(1, tlast_over_time(suse_ai_kubeflow_model_accuracy_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[24h]))),
        1))
      alias: accuracy
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percentunit
  - metricId: suse_ai_kubeflow_pipelines_demo_smoke_tests
    name: Deployment Smoke Test Outcomes
    metricQueries:
    - expression: sum by (inference_service, outcome) (last_over_time(suse_ai_kubeflow_deployment_smoke_test_total{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[24h]) and topk(1, tlast_over_time(suse_ai_kubeflow_deployment_smoke_test_total{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[24h])) by (inference_service))
      alias: ${inference_service} ${outcome}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
- _type: ComponentPresentation
  name: Kubeflow Pipelines API Highlights
  identifier: urn:stackpack:suse-ai:component-presentation:kubeflow-pipelines-api-highlights
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:kubeflow-pipelines" and label = "service.name:kubeflow-pipelines"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_kubeflow_pipelines_api
        title: Kubeflow Pipelines API
        order: 200
        metrics:
        - metricId: suse_ai_kubeflow_pipelines_run_api_rate
          order: 100
        - metricId: suse_ai_kubeflow_pipelines_total_runs
          order: 99
        - metricId: suse_ai_kubeflow_pipelines_run_success_rate
          order: 98
- _type: ComponentPresentation
  name: Kubeflow Workflow Controller Highlights
  identifier: urn:stackpack:suse-ai:component-presentation:kubeflow-pipelines-controller-highlights
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:kubeflow-pipelines" and label = "service.name:kubeflow-workflow-controller"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_kubeflow_pipelines_controller
        title: Kubeflow Workflow Controller
        order: 200
        metrics:
        - metricId: suse_ai_kubeflow_pipelines_workflows_by_phase
          order: 100
        - metricId: suse_ai_kubeflow_pipelines_pods_by_phase
          order: 99
        - metricId: suse_ai_kubeflow_pipelines_oldest_queue_item
          order: 98
