nodes:
- _type: Monitor
  name: Kubeflow Pipelines gRPC Error Ratio
  identifier: urn:stackpack:suse-ai:monitor:kfp-grpc-error-ratio
  description: |
    Triggers when more than 5% of KFP gRPC calls return non-OK status codes.
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    threshold: 0.05
    metric:
      query: |-
        (sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines", service_namespace!="", service_name!="", grpc_code!="OK"}[5m]))
        or (0 * sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines", service_namespace!="", service_name!=""}[5m]))))
        / clamp_min(sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines", service_namespace!="", service_name!=""}[5m])), 0.001)
      aliasTemplate: Kubeflow Pipelines gRPC Error Ratio
      unit: percentunit
    titleTemplate: Kubeflow Pipelines gRPC error ratio exceeds 5%
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-grpc-errors.md.hbs'
