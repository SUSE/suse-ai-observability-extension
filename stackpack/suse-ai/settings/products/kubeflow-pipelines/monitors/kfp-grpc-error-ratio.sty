nodes:
- _type: Monitor
  name: "Pipeline API request reliability"
  identifier: urn:stackpack:suse-ai:monitor:kfp-grpc-error-ratio
  description: "Detects unsuccessful gRPC calls to the pipeline API. An elevated error ratio can indicate problems in pipeline management operations; inspect response codes and API logs."
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    threshold: 0.05
    metric:
      query: '(sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!="", grpc_code!="OK"}[5m]))

        or (0 * sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!=""}[5m]))))

        / clamp_min(sum by (service_namespace, service_name) (rate(grpc_server_handled_total{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!=""}[5m])), 0.001)'
      aliasTemplate: "Pipeline API gRPC error ratio"
      unit: percentunit
    titleTemplate: "Pipeline API request reliability: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-grpc-errors.md.hbs'
