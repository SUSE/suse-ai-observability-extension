nodes:
- _type: Monitor
  name: Kubeflow Recent Pipeline Run Failures
  identifier: urn:stackpack:suse-ai:monitor:kfp-run-failures
  description: |
    Triggers when an Argo workflow enters Failed during the last 15 minutes.
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    threshold: 0
    metric:
      query: sum by (service_namespace, service_name) (increase(argo_workflows_count_total{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!="", phase="Failed"}[15m])) or (0 * sum by (service_namespace, service_name)
        (increase(argo_workflows_count_total{suse_ai_product="kubeflow-pipelines", service_namespace!="", service_name!=""}[15m])))
      aliasTemplate: Kubeflow Recent Pipeline Run Failures
      unit: short
    titleTemplate: Kubeflow pipeline runs failed recently
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-run-failures.md.hbs'
