nodes:
- _type: Monitor
  name: "Workflow controller processing time"
  identifier: urn:stackpack:suse-ai:monitor:kfp-workflow-queue-lag
  description: "Tracks the longest-running task in the workflow controller. Slow processing can delay pipeline scheduling or status updates; inspect the controller for blocked work."
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    threshold: 300
    metric:
      query: max by (service_namespace, service_name) (argo_workflows_queue_longest_running{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!=""})
      aliasTemplate: "Longest-running workflow controller task"
      unit: s
    titleTemplate: "Workflow processing time: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-reconcile-lag.md.hbs'
