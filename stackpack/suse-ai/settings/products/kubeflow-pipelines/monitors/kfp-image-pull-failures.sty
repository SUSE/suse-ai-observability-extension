nodes:
- _type: Monitor
  name: "Pipeline container image availability"
  identifier: urn:stackpack:suse-ai:monitor:kfp-image-pull-failures
  description: "Detects workflow pods that cannot download their container image, preventing affected pipeline steps from starting. Includes image pull failures observed in the last 15 minutes."
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: CRITICAL
    threshold: 0
    metric:
      query: 'sum by (service_namespace, service_name) (increase(argo_workflows_pod_pending_count_total{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!="", reason=~"ErrImagePull|ImagePullBackOff"}[15m]))

        or (0 * sum by (service_namespace, service_name) (argo_workflows_pods_gauge{suse_ai_product="kubeflow-pipelines",
        service_namespace!="", service_name!=""}))'
      aliasTemplate: "Recent workflow image pull failures"
      unit: short
    titleTemplate: "Pipeline image availability: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-image-pull.md.hbs'
