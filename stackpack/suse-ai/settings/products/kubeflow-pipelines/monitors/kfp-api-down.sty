nodes:
- _type: Monitor
  name: "Pipeline API metrics availability"
  identifier: urn:stackpack:suse-ai:monitor:kfp-api-down
  description: "Detects loss of access to the pipeline API's metrics endpoint so operators can restore monitoring coverage. This check measures metrics collection, not whether pipeline API requests succeed."
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: LT
    failureState: CRITICAL
    threshold: 1
    metric:
      query: min by (service_namespace, service_name) (up{suse_ai_product="kubeflow-pipelines", service_namespace!="",
        service_name!="", service_name="kubeflow-pipelines"})
      aliasTemplate: "Pipeline API metrics scrape success"
      unit: short
    titleTemplate: "Pipeline API metrics availability: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-pipelines/remediation-api-down.md.hbs'
