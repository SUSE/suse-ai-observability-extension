nodes:
- _type: ComponentPresentation
  name: Product Milvus
  identifier: urn:stackpack:suse-ai:component-presentation:product-milvus
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:milvus"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_milvus
        title: Milvus
        order: 200
        metrics:
        - metricId: suse_ai_milvus_vectordb_system_search_latency
          order: 100
        - metricId: suse_ai_milvus_vectordb_system_request_success_rate
          order: 99
        - metricId: suse_ai_milvus_vectordb_system_insert_vector_search_rate
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_vectordb
        title: VectorDB
        order: 50
        sections:
        - sectionId: suse_ai_vectordb_latency
          title: Latency
          order: 50
          metrics:
          - metricId: suse_ai_milvus_vectordb_system_request_latency_p99
            order: 100
          - metricId: suse_ai_milvus_vectordb_system_average_request_latency
            order: 99
          - metricId: suse_ai_milvus_vectordb_system_search_latency
            order: 96
          - metricId: suse_ai_milvus_vectordb_system_average_search_latency
            order: 95
          - metricId: suse_ai_milvus_vectordb_system_mutation_send_latency
            order: 91
          - metricId: suse_ai_milvus_vectordb_system_average_mutation_send_latency
            order: 90
        - sectionId: suse_ai_vectordb_utilization
          title: Utilization
          order: 49
          metrics:
          - metricId: suse_ai_milvus_vectordb_system_invsert_vector_count_rate
            order: 98
          - metricId: suse_ai_milvus_vectordb_system_insert_vector_search_rate
            order: 97
        - sectionId: suse_ai_vectordb_request
          title: Request
          order: 48
          metrics:
          - metricId: suse_ai_milvus_vectordb_system_request_success_rate
            order: 94
          - metricId: suse_ai_milvus_vectordb_system_request_failed_rate
            order: 93
          - metricId: suse_ai_milvus_vectordb_system_failed_requests_count
            order: 92
  metrics:
  - metricId: suse_ai_milvus_vectordb_system_request_latency_p99
    name: Request Latency (P99)
    metricQueries:
    - expression: (histogram_quantile(0.99, sum by (le, pod, node_id, function_name) (rate(milvus_proxy_req_latency_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))) / 1000
      alias: ${function_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_milvus_vectordb_system_average_request_latency
    name: Average Request Latency
    metricQueries:
    - expression: (sum by(function_name) (increase(milvus_proxy_req_latency_sum{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))  / sum by(function_name) (increase(milvus_proxy_req_latency_count{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))) / 1000
      alias: ${function_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_milvus_vectordb_system_invsert_vector_count_rate
    name: Insert Vector Count Rate
    metricQueries:
    - expression: sum(rate(milvus_proxy_insert_vectors_count_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Count Rate
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: cps
  - metricId: suse_ai_milvus_vectordb_system_insert_vector_search_rate
    name: Search Vector Count Rate
    metricQueries:
    - expression: sum(rate(milvus_proxy_search_vectors_count_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: Count Rate
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: cps
  - metricId: suse_ai_milvus_vectordb_system_search_latency
    name: Search Latency (P99)
    metricQueries:
    - expression: (histogram_quantile(0.99, sum by (le) (rate(milvus_proxy_sq_latency_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))) / 1000
      alias: Latency
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_milvus_vectordb_system_average_search_latency
    name: Average Search Latency
    metricQueries:
    - expression: (sum by (query_type) (increase(milvus_proxy_sq_latency_sum{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}]))  /
        sum by (query_type) (increase(milvus_proxy_sq_latency_count{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
        / 1000
      alias: ${query_type}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_milvus_vectordb_system_request_success_rate
    name: Request Success Rate
    metricQueries:
    - expression: sum by (function_name) (rate(milvus_proxy_req_count_total{status="success", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))
      alias: ${function_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_milvus_vectordb_system_request_failed_rate
    name: Request Failed Rate
    metricQueries:
    - expression: sum by (function_name) (rate(milvus_proxy_req_count_total{status=~"fail|fail_input|fail_system",
        __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])) or (0 * sum by (function_name)
        (rate(milvus_proxy_req_count_total{status=~"total|success", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}[${__rate_interval}])))
      alias: ${function_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: reqps
  - metricId: suse_ai_milvus_vectordb_system_failed_requests_count
    name: Failed Requests Count
    metricQueries:
    - expression: sum(milvus_proxy_req_count_total{status=~"fail|fail_input|fail_system", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}) or (0 * sum(milvus_proxy_req_count_total{status=~"total|success", __multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}))
      alias: Failure Count
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_milvus_vectordb_system_mutation_send_latency
    name: Mutation Send Latency  (P99)
    metricQueries:
    - expression: (histogram_quantile(0.99, sum by (le, msg_type) (rate(milvus_proxy_mutation_send_latency_bucket{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])))) / 1000
      alias: ${msg_type}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
  - metricId: suse_ai_milvus_vectordb_system_average_mutation_send_latency
    name: Average Mutation Send Latency
    metricQueries:
    - expression: (sum by (msg_type) (increase(milvus_proxy_mutation_send_latency_sum{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}])) / sum by(msg_type) (increase(milvus_proxy_mutation_send_latency_count{__multi__="${selectPrefix(tags,
        'suse.ai.metric.')}"}[${__rate_interval}]))) / 1000
      alias: ${msg_type}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: s
