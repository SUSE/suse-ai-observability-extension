nodes:
- _type: OtelRelationMapping
  identifier: urn:stackpack:suse-ai:otel-relation-mapping:ollama-models
  name: Ollama service serves available model
  input:
    signal: [METRICS]
    resource:
      condition: >-
        'service.name' in resource.attributes && resource.attributes['service.name'] != ''
        && !('suse.ai.managed' in resource.attributes && string(resource.attributes['suse.ai.managed']) == 'false')
      scope:
        metric:
          condition: metric.name == 'ollama_model_info'
          datapoint:
            condition: "'model' in datapoint.attributes && datapoint.attributes['model'] != ''"
            action: "'CREATE'"
  vars:
  - name: namespace
    value: >-
      'service.namespace' in resource.attributes && resource.attributes['service.namespace'] != ''
      ? resource.attributes['service.namespace'] : 'default'
  - name: service
    value: resource.attributes['service.name']
  - name: model
    value: datapoint.attributes['model']
  - name: clusterPrefix
    value: >-
      'k8s.cluster.name' in resource.attributes && resource.attributes['k8s.cluster.name'] != ''
      ? 'cluster/' + resource.attributes['k8s.cluster.name'] + ':' : ''
  expireAfter: 900000
  output:
    sourceId: "'urn:opentelemetry:namespace/' + vars.namespace + ':service/' + vars.service"
    targetId: >-
      'urn:suse-ai:' + vars.clusterPrefix + 'namespace/' + vars.namespace
      + ':service/' + vars.service + ':served-model/' + vars.model
    typeName: "'serves-model'"
    dependencyType: "'CONNECTION'"
