nodes:
- _type: Monitor
  name: 'Model registry service: API probe fails'
  identifier: urn:stackpack:suse-ai:monitor:kubeflow-model-registry-unavailable
  description: 'Triggers when the authenticated registered-models API check does not

    return a 2xx response.

    '
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: LT
    failureState: CRITICAL
    threshold: 1
    metric:
      query: min by (service_namespace, service_name) (httpcheck_status{suse_ai_product="kubeflow-model-registry",
        service_namespace!="", service_name!="", http_status_class="2xx"} and topk by (service_namespace, service_name,
        service_instance_id, http_url) (1, timestamp(httpcheck_status{suse_ai_product="kubeflow-model-registry",
        service_namespace!="", service_name!="", http_status_class="2xx"})))
      aliasTemplate: Kubeflow Model Registry API Unavailable
      unit: short
    titleTemplate: 'Model registry ${service_name}: API probe fails'
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-model-registry/remediation-unavailable.md.hbs'
