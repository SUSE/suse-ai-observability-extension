nodes:
- _type: Monitor
  name: Kubeflow Model Registry API Slow
  identifier: urn:stackpack:suse-ai:monitor:kubeflow-model-registry-slow
  description: |
    Triggers when the synthetic registered-models API check takes longer
    than one second.
  status: ENABLED
  intervalSeconds: 60
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    threshold: 1000
    metric:
      query: max by (service_namespace, service_name) (httpcheck_duration_milliseconds{suse_ai_product="kubeflow-model-registry",
        service_namespace!="", service_name!=""} or httpcheck_duration{suse_ai_product="kubeflow-model-registry", service_namespace!="",
        service_name!=""})
      aliasTemplate: Kubeflow Model Registry API Slow
      unit: ms
    titleTemplate: Kubeflow Model Registry API latency exceeds one second
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/kubeflow-model-registry/remediation-slow.md.hbs'
