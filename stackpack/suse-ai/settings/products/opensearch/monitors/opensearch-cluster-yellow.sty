nodes:
- _type: Monitor
  name: "OpenSearch replica availability"
  identifier: urn:stackpack:suse-ai:monitor:opensearch-cluster-yellow
  description: "Detects an OpenSearch yellow cluster state, where primary shards are assigned but some replicas are not. Data remains available with reduced redundancy and greater exposure to a further node failure."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.0
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: "Cluster yellow status"
      query: max by (service_namespace, service_name) (elasticsearch_cluster_health{suse_ai_product="opensearch",
        service_namespace!="", service_name!="", status="yellow"}) or (0 * sum by (service_namespace, service_name)
        (elasticsearch_cluster_health{suse_ai_product="opensearch", service_namespace!="", service_name!=""}))
      unit: short
    titleTemplate: "OpenSearch replica availability: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/opensearch/remediation-yellow.md.hbs'
