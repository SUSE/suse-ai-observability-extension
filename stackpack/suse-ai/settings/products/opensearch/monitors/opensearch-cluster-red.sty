nodes:
- _type: Monitor
  name: "OpenSearch data availability"
  identifier: urn:stackpack:suse-ai:monitor:opensearch-cluster-red
  description: "Detects an OpenSearch red cluster state, indicating at least one unavailable primary shard. Searches or writes involving affected shards may fail until data availability is restored."
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    threshold: 0.0
    comparator: GT
    failureState: CRITICAL
    metric:
      aliasTemplate: "Cluster red status"
      query: max by (service_namespace, service_name) (elasticsearch_cluster_health{suse_ai_product="opensearch",
        service_namespace!="", service_name!="", status="red"}) or (0 * sum by (service_namespace, service_name)
        (elasticsearch_cluster_health{suse_ai_product="opensearch", service_namespace!="", service_name!=""}))
      unit: short
    titleTemplate: "OpenSearch data availability: ${service_name}"
    urnTemplate: urn:opentelemetry:namespace/${service_namespace}:service/${service_name}
  remediationHint: !include 'remediation-hints/opensearch/remediation-red.md.hbs'
