nodes:
- _type: ComponentPresentation
  name: Product Elasticsearch
  identifier: urn:stackpack:suse-ai:component-presentation:product-elasticsearch
  binding:
    _type: ComponentPresentationQueryBinding
    query: (label = "stackpack:open-telemetry" and type in ("otel service", "otel service instance") and label =
      "stackpack:suse-ai") and label = "suse.ai.product:elasticsearch"
  rank:
    specificity: 1
  presentation:
    highlight:
      metrics:
      - sectionId: suse_ai_product_elasticsearch
        title: Elasticsearch
        order: 200
        metrics:
        - metricId: suse_ai_elasticsearch_vectordb_pending_tasks_count
          order: 100
        - metricId: suse_ai_elasticsearch_vectordb_green
          order: 99
        - metricId: suse_ai_elasticsearch_vectordb_yellow
          order: 98
    metricPerspective:
      tabs:
      - tabId: suse_ai_vectordb
        title: VectorDB
        order: 50
        sections:
        - sectionId: suse_ai_vectordb_request
          title: Request
          order: 50
          metrics:
          - metricId: suse_ai_elasticsearch_vectordb_pending_tasks_count
            order: 100
        - sectionId: suse_ai_vectordb_status
          title: Status
          order: 49
          metrics:
          - metricId: suse_ai_elasticsearch_vectordb_green
            order: 99
          - metricId: suse_ai_elasticsearch_vectordb_yellow
            order: 98
          - metricId: suse_ai_elasticsearch_vectordb_red
            order: 97
        - sectionId: suse_ai_vectordb_disk_space
          title: Disk Space
          order: 48
          metrics:
          - metricId: suse_ai_elasticsearch_vectordb_free_space
            order: 96
        - sectionId: suse_ai_vectordb_operations
          title: Operations
          order: 47
          metrics:
          - metricId: suse_ai_elasticsearch_vectordb_operation
            order: 95
  metrics:
  - metricId: suse_ai_elasticsearch_vectordb_pending_tasks_count
    name: Pending Tasks
    metricQueries:
    - expression: sum(elasticsearch_cluster_pending_tasks{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
      alias: Pending tasks count
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_elasticsearch_vectordb_green
    name: Cluster Status (Green)
    metricQueries:
    - expression: elasticsearch_cluster_health{status="green", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Cluster is Green (no issues)
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_elasticsearch_vectordb_yellow
    name: Cluster Status (Yellow)
    metricQueries:
    - expression: elasticsearch_cluster_health{status="yellow", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Cluster is Yellow (deviating)
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_elasticsearch_vectordb_red
    name: Cluster Status (Red)
    metricQueries:
    - expression: elasticsearch_cluster_health{status="red", __multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}
      alias: Cluster is Red (attention required)
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
  - metricId: suse_ai_elasticsearch_vectordb_free_space
    name: Free Disk (%)
    metricQueries:
    - expression: (elasticsearch_node_fs_disk_free_bytes{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"} /
        elasticsearch_node_fs_disk_total_bytes{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"}) * 100
      alias: ${elasticsearch_node_name}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: percent
  - metricId: suse_ai_elasticsearch_vectordb_operation
    name: Completed Operations Count
    metricQueries:
    - expression: sum(elasticsearch_index_operations_completed_total{__multi__="${selectPrefix(tags, 'suse.ai.metric.')}"})
        by (operation)
      alias: ${operation}
      primary: true
    chart:
      _type: TimeSeriesChart
      unit: short
