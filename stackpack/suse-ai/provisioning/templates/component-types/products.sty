  # ViewType for application with traces support
  - _type: "ViewType"
    name: "Application view definition"
    identifier: "urn:stackpack:suse-ai:shared:view-type:application"
    filters:
      - _type: "TopologyFilters"
        tabs:
          - "EVENTS"
          - "TRACES"
    flags:
      - "NoTopologyFilters"
    overview:
      columns:
        - _type: "ViewTypeTableColHealth"
        - _type: "ViewTypeTableColName"
          title: "Component"

  # Define which traces to show for application components
  - _type: TraceBinding
    name: Traces for GenAI Application
    identifier: urn:stackpack:suse-ai:shared:trace-binding:application
    filter:
      attributes:
        service.name: ["${name}"]
    scope: (type = "application")

  # Show a link to application component on span details
  - _type: SpanToComponentBinding
    name: Span binding to GenAI Application
    identifier: urn:stackpack:suse-ai:shared:span-to-component-binding:application
    urnTemplate: "urn:suse-ai:product:application:${resource.suse.ai.component.name}"

