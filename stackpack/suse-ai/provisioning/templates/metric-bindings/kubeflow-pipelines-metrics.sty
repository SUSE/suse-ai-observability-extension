  - id: -640
    name: "Run API Request Rate"
    description: "Run-server API calls per second by operation."
    queries:
      - expression: 'rate(run_server_create_requests_total[${__rate_interval}])'
        alias: "create"
      - expression: 'rate(run_server_get_requests_total[${__rate_interval}])'
        alias: "get"
        primary: true
      - expression: 'rate(run_server_list_requests_total[${__rate_interval}])'
        alias: "list"
      - expression: 'rate(run_server_terminate_requests_total[${__rate_interval}])'
        alias: "terminate"
    scope: 'type = "workflow-engine.kubeflow-pipelines"'
    identifier: "urn:stackpack:suse-ai:shared:metric-binding:kubeflow-pipelines:run-api-rate"
    unit: reqps
    chartType: line
    priority: high
    enabled: true
    layout:
      metricPerspective:
        tab: "Kubeflow Pipelines"
        section: Pipeline Runs
      componentSummary:
        weight: 3
    _type: MetricBinding

  - id: -641
    name: "Pipeline API Request Rate"
    description: "Pipeline-server API calls per second by operation."
    queries:
      - expression: 'rate(pipeline_server_create_requests_total[${__rate_interval}])'
        alias: "create"
      - expression: 'rate(pipeline_server_list_requests_total[${__rate_interval}])'
        alias: "list"
        primary: true
      - expression: 'rate(pipeline_server_get_requests_total[${__rate_interval}])'
        alias: "get"
      - expression: 'rate(pipeline_upload_requests_total[${__rate_interval}])'
        alias: "upload"
    scope: 'type = "workflow-engine.kubeflow-pipelines"'
    identifier: "urn:stackpack:suse-ai:shared:metric-binding:kubeflow-pipelines:pipeline-api-rate"
    unit: reqps
    chartType: line
    priority: high
    enabled: true
    layout:
      metricPerspective:
        tab: "Kubeflow Pipelines"
        section: Control Plane
      componentSummary:
        weight: 2
    _type: MetricBinding

  - id: -642
    name: "Total Pipeline Runs"
    description: "Cumulative number of pipeline runs known to the API server."
    queries:
      - expression: 'run_server_run_count'
        alias: "runs"
        primary: true
    scope: 'type = "workflow-engine.kubeflow-pipelines"'
    identifier: "urn:stackpack:suse-ai:shared:metric-binding:kubeflow-pipelines:total-runs"
    unit: short
    chartType: line
    tags:
      experimental_chartType: Gauge
      enableGaugeChart: "1"
    priority: high
    enabled: true
    layout:
      metricPerspective:
        tab: "Kubeflow Pipelines"
        section: Pipeline Runs
      componentSummary:
        weight: 3
    _type: MetricBinding

  - id: -643
    name: "Object Inventory"
    description: "Registered pipelines, pipeline versions, and recurring jobs."
    queries:
      - expression: 'pipeline_server_pipeline_count'
        alias: "pipelines"
        primary: true
      - expression: 'pipeline_server_pipeline_version_count'
        alias: "versions"
      - expression: 'job_server_job_count'
        alias: "recurring jobs"
    scope: 'type = "workflow-engine.kubeflow-pipelines"'
    identifier: "urn:stackpack:suse-ai:shared:metric-binding:kubeflow-pipelines:object-inventory"
    unit: short
    chartType: line
    priority: high
    enabled: true
    layout:
      metricPerspective:
        tab: "Kubeflow Pipelines"
        section: Control Plane
      componentSummary:
        weight: 2
    _type: MetricBinding
