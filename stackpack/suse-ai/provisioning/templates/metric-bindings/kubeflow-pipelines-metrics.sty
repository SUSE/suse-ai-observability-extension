  - id: -667
    name: "Demo Step Duration P95"
    description: "P95 duration of each step in the latest instrumented Iris lifecycle run within 24 hours."
    queries:
      # Pipeline step pods are intentionally short-lived and export a single
      # cumulative point. Keep the last value for 24 hours, then use its sample
      # timestamp to select only the newest pod for every step and bucket.
      - expression: 'histogram_quantile(0.95, sum by (le, step) (last_over_time(suse_ai_kubeflow_pipeline_step_duration_seconds_bucket{suse_ai_component_name="kubeflow-pipelines"}[24h]) and topk(1, tlast_over_time(suse_ai_kubeflow_pipeline_step_duration_seconds_bucket{suse_ai_component_name="kubeflow-pipelines"}[24h])) by (le, step)))'
        alias: "${step}"
        primary: true
    scope: 'type = "workflow-engine.kubeflow-pipelines"'
    identifier: "urn:stackpack:suse-ai:shared:metric-binding:kubeflow-pipelines:demo-step-duration-p95"
    unit: s
    chartType: line
    priority: high
    enabled: true
    layout:
