nodes:
- _type: ComponentPresentation
  name: GPU devices
  identifier: urn:stackpack:suse-ai:component-presentation:spike-gpus
  binding:
    _type: ComponentPresentationQueryBinding
    query: type = "genai gpu" and label = "stackpack:suse-ai"
  rank: {specificity: 220}
  presentation:
    icon: !icon gpu-device.svg
    overview:
      name: {singular: GPU, plural: GPUs, title: GPUs}
      mainMenu: {group: SUSE AI, order: 10}
      columns:
      - columnId: gpu_uuid
        title: GPU
        projection: {_type: ComponentLinkProjection, name: name, identifier: 'identifiers[0]'}
      - columnId: gpu_model
        title: Model
        projection: {_type: TextProjection, value: "tags.singleValue('gpu.model')"}
      - columnId: gpu_node
        title: Node
        projection:
          _type: ComponentLinkProjection
          name: tags.singleValue('gpu.node')
          identifier: "'urn:kubernetes:/' + tags.singleValue('cluster-name') + ':node/' + tags.singleValue('gpu.node')"
      - columnId: gpu_cluster
        title: Cluster
        projection: {_type: TextProjection, value: "tags.singleValue('cluster-name')"}
    highlight:
      title: GPU device
      fields:
      - fieldId: gpu_model
        title: Model
        order: 1
        projection: {_type: TextProjection, value: "tags.singleValue('gpu.model')"}
      relatedResources:
      - resourceId: allocated_pods
        title: Allocated pods
        order: 2
        topologyQuery: 'withNeighborsOf(direction = "down", components = (identifier = "${identifiers[0]}"), levels = "1") and type = "pod"'
      - resourceId: gpu_node
        title: Node
        order: 1
        topologyQuery: 'withNeighborsOf(direction = "down", components = (identifier = "${identifiers[0]}"), levels = "1") and type = "node"'
